#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Surface { vec4 field[]; };
layout(std430, binding = 1) writeonly buffer Pixels { uint pixels[]; };
layout(std140, binding = 2) uniform Simulation {
    uint resolution;
    uint modeCount;
    float domainMetres;
    float seconds;
    float choppiness;
    float windSpeed;
    float cameraX;
    float cameraZ;
    float cameraZoom;
    float sun;
    uint paused;
    uint debugCpu;
} sim;
layout(push_constant) uniform Viewport { uint width; uint height; } view;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

uint bgra8(vec3 linearColour) {
    vec3 c = pow(clamp(linearColour, 0.0, 1.0), vec3(1.0 / 2.2));
    uvec3 q = uvec3(c * 255.0 + 0.5);
    return 0xff000000u | (q.r << 16u) | (q.g << 8u) | q.b;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= view.width || pixel.y >= view.height) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(view.width, view.height);
    float aspect = float(view.width) / float(view.height);

    // Cinematic oblique map projection. It makes the complete simulated field
    // visible without a raster pipeline and keeps presentation Vulkan-compute only.
    vec2 plane = vec2((uv.x - 0.5) * aspect, (0.78 - uv.y) * 1.30);
    float perspective = mix(0.35, 1.7, clamp(uv.y, 0.0, 1.0));
    vec2 world = vec2(plane.x * perspective, plane.y) * sim.cameraZoom + vec2(sim.cameraX, sim.cameraZ);
    vec2 gridf = (world / sim.domainMetres + 0.5) * float(sim.resolution - 1u);

    vec3 skyTop = mix(vec3(0.03, 0.18, 0.40), vec3(0.12, 0.08, 0.24), sim.sun);
    vec3 skyHorizon = mix(vec3(0.48, 0.72, 0.88), vec3(1.0, 0.44, 0.16), sim.sun);
    vec3 colour = mix(skyTop, skyHorizon, smoothstep(0.0, 0.72, uv.y));

    if (all(greaterThanEqual(gridf, vec2(0.0))) && all(lessThan(gridf, vec2(sim.resolution - 1u)))) {
        ivec2 cell = ivec2(gridf);
        vec4 s = field[uint(cell.y) * sim.resolution + uint(cell.x)];
        vec3 normal = normalize(vec3(-s.y, 1.0, -s.z));
        vec3 light = normalize(vec3(-0.35, 0.8, 0.48));
        float diffuse = max(dot(normal, light), 0.0);
        float fresnel = pow(1.0 - max(normal.y * 0.75, 0.0), 5.0);
        float crest = smoothstep(0.05, 0.65, s.x);
        vec3 deep = vec3(0.015, 0.16, 0.25);
        vec3 shallow = vec3(0.02, 0.46, 0.50);
        colour = mix(deep, shallow, 0.28 + 0.32 * diffuse + 0.12 * crest);
        colour += mix(skyHorizon, skyTop, normal.y) * (0.18 + 0.52 * fresnel);
        colour += vec3(1.0, 0.82, 0.58) * pow(max(dot(reflect(-light, normal), normalize(vec3(0.0, 1.0, 0.7))), 0.0), 90.0);

        // Particle-pull compositor: each compressed cell owns a seeded bubble
        // sprite. The water colour above has no foam mask; only these discrete
        // circular particles make whitewater visible.
        vec2 local = fract(gridf) - 0.5;
        float seed = hash12(vec2(cell));
        float radius = 0.10 + 0.22 * seed;
        float particle = 1.0 - smoothstep(radius * 0.65, radius, length(local));
        float alive = step(0.60 - 0.45 * seed, s.w);
        colour = mix(colour, vec3(0.88, 0.96, 1.0), particle * alive * (0.50 + 0.45 * seed));
    }

    if (sim.debugCpu != 0u) {
        colour = mix(colour, vec3(0.2, 1.0, 0.3), step(0.495, abs(uv.x - 0.5)) * step(abs(uv.x - 0.5), 0.505));
    }
    pixels[pixel.y * view.width + pixel.x] = bgra8(colour);
}
