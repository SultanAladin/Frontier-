#version 450

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Surface { vec4 field[]; };
layout(std430, binding = 1) writeonly buffer Pixels { uint pixels[]; };
layout(std140, binding = 2) uniform Simulation {
    uint resolution;
    uint modeCount;
    float domainMetres;
    float seconds;
    float choppiness;
    float windSpeed;
    float cameraX;
    float cameraZ;
    float cameraZoom;
    float sun;
    uint paused;
    uint debugCpu;
} sim;
layout(push_constant) uniform Viewport { uint width; uint height; } view;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec4 sampleSurface(vec2 worldXZ) {
    vec2 grid = (worldXZ / sim.domainMetres + 0.5) * float(sim.resolution - 1u);
    vec2 base = floor(grid);
    vec2 f = grid - base;
    ivec2 a = ivec2(clamp(base, vec2(0.0), vec2(float(sim.resolution - 1u))));
    ivec2 b = min(a + ivec2(1), ivec2(sim.resolution - 1u));
    vec4 s00 = field[uint(a.y) * sim.resolution + uint(a.x)];
    vec4 s10 = field[uint(a.y) * sim.resolution + uint(b.x)];
    vec4 s01 = field[uint(b.y) * sim.resolution + uint(a.x)];
    vec4 s11 = field[uint(b.y) * sim.resolution + uint(b.x)];
    return mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
}

vec3 skyColour(vec3 ray, vec3 sunDirection) {
    float horizon = pow(1.0 - clamp(ray.y, 0.0, 1.0), 3.0);
    vec3 sky = mix(vec3(0.025, 0.11, 0.30), vec3(0.43, 0.68, 0.84), horizon);
    float sunDisc = pow(max(dot(ray, sunDirection), 0.0), 1200.0);
    float sunGlow = pow(max(dot(ray, sunDirection), 0.0), 22.0);
    return sky + vec3(1.0, 0.78, 0.48) * (sunDisc * 7.0 + sunGlow * 0.16);
}

uint bgra8(vec3 linearColour) {
    vec3 c = pow(clamp(linearColour, 0.0, 1.0), vec3(1.0 / 2.2));
    uvec3 q = uvec3(c * 255.0 + 0.5);
    return 0xff000000u | (q.r << 16u) | (q.g << 8u) | q.b;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= view.width || pixel.y >= view.height) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(view.width, view.height);
    float aspect = float(view.width) / float(view.height);
    vec3 camera = vec3(42.0 + sim.cameraX, 8.5, 78.0 + sim.cameraZ);
    vec3 target = vec3(-8.0 + sim.cameraX, 0.0, -30.0 + sim.cameraZ);
    vec3 forward = normalize(target - camera);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = normalize(cross(right, forward));
    float tanHalfFov = clamp(sim.cameraZoom / 300.0, 0.32, 0.92);
    vec2 ndc = vec2((uv.x * 2.0 - 1.0) * aspect, 1.0 - uv.y * 2.0);
    vec3 ray = normalize(forward + right * ndc.x * tanHalfFov + up * ndc.y * tanHalfFov);
    vec3 sunDirection = normalize(vec3(0.48, 0.72, 0.36));
    vec3 colour = skyColour(ray, sunDirection);

    float previousT = 0.75;
    vec3 previousPoint = camera + ray * previousT;
    float previousDistance = previousPoint.y - sampleSurface(previousPoint.xz).x;
    float hitT = -1.0;
    float halfDomain = sim.domainMetres * 0.5;
    for (int stepIndex = 0; stepIndex < 150; ++stepIndex) {
        float t = 0.75 + float(stepIndex + 1) * 2.0;
        vec3 point = camera + ray * t;
        bool inDomain = abs(point.x) <= halfDomain && abs(point.z) <= halfDomain;
        float distanceToSurface = point.y - sampleSurface(clamp(point.xz, vec2(-halfDomain), vec2(halfDomain))).x;
        if (inDomain && previousDistance > 0.0 && distanceToSurface <= 0.0) {
            float lo = previousT, hi = t;
            for (int refine = 0; refine < 6; ++refine) {
                float mid = (lo + hi) * 0.5;
                vec3 probe = camera + ray * mid;
                float signedDistance = probe.y - sampleSurface(probe.xz).x;
                if (signedDistance > 0.0) lo = mid; else hi = mid;
            }
            hitT = (lo + hi) * 0.5;
            break;
        }
        previousT = t;
        previousDistance = distanceToSurface;
    }

    if (hitT > 0.0) {
        vec3 world = camera + ray * hitT;
        vec4 surface = sampleSurface(world.xz);
        vec3 normal = normalize(vec3(-surface.y, 1.0, -surface.z));
        vec3 viewDirection = -ray;
        vec3 reflectedRay = reflect(ray, normal);
        float fresnel = 0.02 + 0.98 * pow(1.0 - max(dot(normal, viewDirection), 0.0), 5.0);
        float diffuse = max(dot(normal, sunDirection), 0.0);
        vec3 halfVector = normalize(sunDirection + viewDirection);
        float specular = pow(max(dot(normal, halfVector), 0.0), 180.0) * 3.2;
        float crestLight = smoothstep(0.05, 0.75, surface.x);
        vec3 body = mix(vec3(0.004, 0.045, 0.10), vec3(0.01, 0.30, 0.36), 0.18 + diffuse * 0.36 + crestLight * 0.18);
        vec3 reflection = skyColour(reflectedRay, sunDirection);
        colour = mix(body, reflection, fresnel);
        colour += vec3(1.0, 0.83, 0.60) * specular;
        colour = mix(colour, vec3(0.36, 0.62, 0.73), smoothstep(150.0, 285.0, hitT) * 0.62);

        // Particle pull: compression emits discrete world-space whitecaps.
        // The water BRDF above contains no foam term.
        vec2 grid = (world.xz / sim.domainMetres + 0.5) * float(sim.resolution - 1u);
        vec2 cell = floor(grid);
        float seed = hash12(cell);
        vec2 jitter = vec2(hash12(cell + vec2(17.0, 3.0)), hash12(cell + vec2(5.0, 31.0))) - 0.5;
        vec2 local = fract(grid) - 0.5 - jitter * 0.46;
        float radius = 0.08 + seed * 0.10;
        float particle = 1.0 - smoothstep(radius * 0.68, radius, length(local));
        float alive = step(0.075, surface.w) * step(0.10, surface.x) * step(0.88, seed);
        colour = mix(colour, vec3(0.82, 0.93, 0.97), particle * alive * 0.72);
    }

    if (sim.debugCpu != 0u && abs(uv.x - 0.5) < 0.0015) colour = vec3(0.2, 1.0, 0.3);
    pixels[pixel.y * view.width + pixel.x] = bgra8(colour);
}
