{
  "name": "frontier-engine-audio-sim",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Frontier Engine Audio Sim v3 — hybrid exhaust-pulse + order synthesis. Combines the raw per-cylinder detail of EngineAudioSim (main) with the per-car exhaust character of the patch-1 GT3 simulator, plus a rebuilt Ferrari LaFerrari exhaust profile.",
  "scripts": {
    "dev": "vite --port=5174 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=5174 --host=0.0.0.0",
    "test:worklet": "esbuild test/worklet-harness.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/worklet-harness.mjs && node node_modules/.cache/worklet-harness.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
