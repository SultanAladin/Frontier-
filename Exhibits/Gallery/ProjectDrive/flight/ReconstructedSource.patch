+            if (!ReadContact(Index, Arm, Normal, Separation)) continue;
+            if (Sweep == 0u) Contacts.ArrivalPenetration = std::max(Contacts.ArrivalPenetration, -Separation);
+            auto& Constraint = ContactConstraints[Index];
