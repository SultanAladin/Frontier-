-    const int ring = e > 0.70710678f ? 1 : 0;       // 45 degrees splits the two rings
-    const float az = std::atan2(dot(d,b), dot(d,t)) + PI;
-    const int sector = std::min(3, (int)(az / (PI*0.5f)));
-    return ring*4 + sector;
-}
