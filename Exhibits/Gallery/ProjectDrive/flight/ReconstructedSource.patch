-void main()
-{
-    uint si = gl_GlobalInvocationID.x;
-    if (si >= PC.Counts.x) return;
-    if (Surfels[si].Albedo.w < 0.5) return;         // skip dead slots
-    Surfels[si].Irradiance = Surfels[si].IrradianceNew;
-}
