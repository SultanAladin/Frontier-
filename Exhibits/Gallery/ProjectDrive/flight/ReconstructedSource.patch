+            !Append(Scene.QueryFlatTriangles(), Vulkan->FlatTriangles) || !Append(Scene.QueryLuminaires(), Vulkan->Luminaires)) return false;
+        Vulkan->PendingGeometry.swap(Publications);
+        return true;
+    }
