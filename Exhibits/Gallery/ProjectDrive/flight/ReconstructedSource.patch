+            const float Closing = Frontier::Vehicle::Dot(Velocity, Normal);
+            const float Previous = Constraint.NormalImpulse;
+            Constraint.NormalImpulse = std::max(0.0f, Previous - Closing / EffectiveInverseMass(Arm, Normal));
