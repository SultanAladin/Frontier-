+        this.Live = null;   // Cabin: { Speed [km/h], Temperatures [°C ×4], Pressures [kPa ×4], Tread [0–1 ×4], States [string ×4] }
+        this.Scale = 1.6;
+        this.OffsetAcross = 0;
+        this.OffsetDown = 0;
