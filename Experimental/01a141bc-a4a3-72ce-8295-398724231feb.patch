+        const Material = () => FractureMaterials[Prop.Recipe.Material];
+        Entities.push({
+            Id: `prop-${Prop.Index}`, Group: "Destruction", Name: Prop.Definition.Name, Type: "Breakable prop", Parent: "fracture",
