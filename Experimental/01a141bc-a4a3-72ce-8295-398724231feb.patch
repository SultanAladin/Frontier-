+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                    TOUCH
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 A world ray against the tablet's glass: the panel fraction (Across, Down ∈ [0, 1]) or null.
+    QueryTabletHit(Origin, Direction, BodyTransform)
