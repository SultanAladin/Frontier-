+++ b/Experimental/IlluminationHost/Style/FrontierEditor.css
@@ -0,0 +1,1735 @@
+/*==========================================================================================================================================
+                                                            FRONTIEREDITOR.CSS
+==========================================================================================================================================
+ 🧩 The Frontier Editor's look for the exhibit: outliner, viewport and inspector columns, cards, metrics, sliders and switches.
+
+ 📝 Tokens transcribed from Experimental/FrontierEditor/style.css and the native C++ conversion recorded in
+    Docs/FrontierEditorComponents.md: DM Sans 13 px on #101010; outliner #161616 with 43 px tree rows; cards as a
+    #222 → #1f1f1f gradient with a #2f2f2f border and 18 px radius; 45 px weight-300 metrics; 3 px slider rails
+    (#c5c5c5 fill over #444) with an 11 px thumb ringed in #222; pills, switches and segmented controls as in the native
+    Fracture and Gas cards. Only the exhibit's own additions (the viewport header, the status bar) are new.
+==========================================================================================================================================*/
+
+@font-face { font-family: "DM Sans"; font-style: normal; font-weight: 300; font-display: swap; src: url("Fonts/dm-sans-latin-300-normal.woff2") format("woff2"); }
+@font-face { font-family: "DM Sans"; font-style: normal; font-weight: 400; font-display: swap; src: url("Fonts/dm-sans-latin-400-normal.woff2") format("woff2"); }
+@font-face { font-family: "DM Sans"; font-style: normal; font-weight: 500; font-display: swap; src: url("Fonts/dm-sans-latin-500-normal.woff2") format("woff2"); }
+
+:root
+{
+    --ground: #101010;
+    --column: #161616;
+    --edge: #2a2a2a;
+    --text: #dcdcdc;
+    --soft: #b4b4b4;
+    --muted: #7d7d7d;
+    --faint: #5c5c5c;
+    --accent: #c5c5c5;
+    --on: #3ec46d;
+    --warn: #e0a24a;
+    --fail: #ff6b6b;
+    --mono: "JetBrains Mono", Consolas, "Courier New", monospace;
+    color-scheme: dark;
+}
+
+*
+{
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+}
+
+html, body
+{
+    width: 100%;
+    height: 100%;
+    overflow: hidden;
+    background: var(--ground);
+    color: var(--text);
+    font: 400 13px/1.35 "DM Sans", -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+    font-synthesis: none;
+}
+
+button
+{
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: 0;
+    cursor: pointer;
+    transition: background .18s, color .18s, opacity .18s, border-color .18s;
+}
+
+input, select
+{
+    font: inherit;
+    color: inherit;
+}
+
+.hidden
+{
+    display: none !important;
+}
+
+.glyph
+{
+    display: inline-flex;
+    flex: none;
+}
+
+/*------------------------------------------------------------------------------------------------------------------------------------------
+                                                                  SHELL
+------------------------------------------------------------------------------------------------------------------------------------------*/
+
+#shell
+{
+    position: absolute;
+    inset: 0;
+    display: grid;
+    grid-template-columns: 288px minmax(0, 1fr) 380px;
+    grid-template-rows: minmax(0, 1fr) 28px;
+    grid-template-areas: "outliner viewport inspector" "status status status";
+}
+
+body.panels-hidden #shell
+{
+    grid-template-columns: 0 minmax(0, 1fr) 0;
+}
+
+body.panels-hidden .editor-column
+{
+    display: none;
+}
+
+.column
+{
+    min-width: 0;
+    min-height: 0;
+    display: flex;
+    flex-direction: column;
+    background: var(--column);
+}
+
+.column-tabs
+{
+    flex: none;
+    height: 34px;
+    display: flex;
+    align-items: stretch;
+    background: #0d0d0d;
+    border-bottom: 1px solid var(--edge);
+}
+
+.column-tab
+{
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 0 12px 0 16px;
+    font-size: 11px;
+    color: #cfcfcf;
+    background: var(--column);
+    border-right: 1px solid var(--edge);
+}
+
+.column-tab button
+{
+    display: grid;
+    place-items: center;
+    width: 18px;
+    height: 18px;
+    border-radius: 5px;
+    color: #8a8a8a;
+}
+
+.column-tab button:hover
+{
+    background: #2a2a2a;
+    color: #e0e0e0;
+}
+
+.column-tabs .tab-fill
+{
+    flex: 1;
+}
+
+/*------------------------------------------------------------------------------------------------------------------------------------------
+                                                                OUTLINER
+------------------------------------------------------------------------------------------------------------------------------------------*/
+
+#outliner
+{
+    grid-area: outliner;
+    border-right: 1px solid var(--edge);
+}
+
+.outliner-body
+{
+    flex: 1;
+    min-height: 0;
+    overflow-y: auto;
+    padding: 22px 14px 14px;
+    display: flex;
+    flex-direction: column;
+}
+
+.brand
+{
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 0 8px 26px;
+    font-size: 23px;
+    letter-spacing: -1.1px;
+    font-weight: 500;
+}
+
+.brand .brand-symbol
+{
+    display: flex;
+    transform: rotate(-10deg);
+    color: #c2c2c2;
+}
+
+.brand .brand-dot
+{
+    color: #a8a8a8;
+}
+
+.brand .version
+{
+    margin-left: auto;
+    font-size: 9px;
+    letter-spacing: 1.4px;
+    color: #6f6f6f;
+    font-weight: 500;
+}
+
+.scene-label
+{
+    color: #717171;
+    font-size: 9px;
+    font-weight: 600;
+    letter-spacing: 1.6px;
+    padding: 0 10px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+}
+
+.status-dot
+{
+    height: 5px;
+    width: 5px;
+    background: var(--on);
+    border-radius: 100%;
+    display: inline-block;
+    box-shadow: 0 0 6px #3ec46d88;
+}
+
+.scene-title
+{
+    font-size: 16px;
+    padding: 10px 10px 20px;
+    letter-spacing: -.4px;
+}
+
+.scene-title .scene-extension
+{
+    color: #6f6f6f;
+}
+
+.count-tiles
+{
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 9px;
+    padding: 0 2px 16px;
+}
+
+.count-tile
+{
+    position: relative;
+    height: 62px;
+    padding: 10px 12px;
+    border-radius: 14px;
+    background: #1c1c1c;
+    border: 1px solid #2c2c2c;
+}
+
+.count-tile .count-icon
+{
+    width: 22px;
+    height: 22px;
+    border-radius: 50%;
+    display: grid;
+    place-items: center;
+    background: var(--on);
+    color: #0b2414;
+}
+
+.count-tile.hidden-count .count-icon
+{
+    background: #2c2c2c;
+    color: #8a8a8a;
+}
+
+.count-tile .count-caption
+{
+    position: absolute;
+    left: 12px;
+    bottom: 8px;
+    font-size: 10px;
+    color: #9a9a9a;
+}
+
+.count-tile .count-value
+{
+    position: absolute;
+    right: 13px;
+    top: 13px;
+    font-size: 27px;
+    font-weight: 300;
+    letter-spacing: -1px;
+    color: #e6e6e6;
+}
+
+.outliner-heading
+{
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0 10px 10px;
+}
+
+.outliner-heading h2
+{
+    font-size: 12px;
+    font-weight: 500;
+}
+
+.outliner-heading h2 span
+{
+    font-size: 10px;
+    color: #7e7e7e;
+    border: 1px solid #313131;
+    border-radius: 5px;
+    padding: 2px 5px;
+    margin-left: 6px;
+}
+
+.search
+{
+    height: 34px;
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    background: #1d1d1d;
+    border: 1px solid #282828;
+    border-radius: 8px;
+    padding: 0 11px;
+    margin: 0 4px 18px;
+    color: #707070;
+}
+
+.search input
+{
+    width: 100%;
+    border: 0;
+    background: transparent;
+    font-size: 11px;
+    color: #cccccc;
+    outline: none;
+}
+
+.search input::placeholder
+{
+    color: #767676;
+}
+
+.group
+{
+    margin-bottom: 16px;
+}
+
+.group-label
+{
+    display: flex;
+    align-items: center;
+    width: 100%;
+    font-size: 10px;
+    color: #818181;
+    padding: 0 10px 8px;
+    gap: 7px;
+    letter-spacing: .3px;
+}
+
+.group-count
+{
+    margin-left: auto;
+    color: #575757;
+    font-size: 9px;
+}
+
+.tree-row
+{
+    display: flex;
+    margin: 2px 2px;
+    border-radius: 8px;
+    height: 38px;
+    border: 1px solid transparent;
+    position: relative;
+}
+
+.tree-row:hover
+{
+    background: #202020;
+}
+
+.tree-row.selected
+{
+    background: linear-gradient(110deg, #333, #292929);
+    border-color: #434343;
+    box-shadow: inset 0 1px #ffffff06, 0 3px 8px #0002;
+}
+
+.tree-row.selected::before
+{
+    content: "";
+    position: absolute;
+    width: 2px;
+    height: 16px;
+    background: var(--entity-colour, #e8e8e8);
+    left: -4px;
+    top: 10px;
+    border-radius: 2px;
+}
+
+.tree-row.nested .object-button
+{
+    padding-left: 38px;
+}
+
+.object-button
+{
+    display: flex;
+    align-items: center;
+    gap: 11px;
+    flex: 1;
+    min-width: 0;
+    text-align: left;
+    padding: 0 6px 0 16px;
+    color: #a3a3a3;
+    font-size: 12px;
+}
+
+.object-button > .glyph
+{
+    color: var(--entity-colour, #848484);
+    opacity: .85;
+}
+
+.object-button .row-name
+{
+    flex: 1;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.object-button .row-meta
+{
+    font-size: 9px;
+    color: #666;
+    white-space: nowrap;
+}
+
+.selected .object-button
+{
+    color: #f1f1f1;
+}
+
+.row-state
+{
+    width: 7px;
+    height: 7px;
+    border-radius: 50%;
+    margin: 0 4px 0 2px;
+    align-self: center;
+    background: #3a3a3a;
+}
+
+.row-state.live
+{
+    background: var(--on);
+}
+
+.row-state.warm
+{
+    background: var(--warn);
+}
+
+.visibility
+{
+    display: grid;
+    place-items: center;
+    width: 30px;
+    color: #6a6a6a;
+    opacity: 0;
+}
+
+.tree-row:hover .visibility, .selected .visibility, .tree-row.is-off .visibility
+{
+    opacity: 1;
+}
+
+.tree-row.is-off .object-button
+{
+    opacity: .45;
+}
+
+.outliner-bottom
+{
+    margin-top: auto;
+    display: flex;
+    align-items: center;
+    gap: 11px;
+    padding: 16px 10px 2px;
+    border-top: 1px solid #292929;
+}
+
+.world-icon
+{
+    border-radius: 8px;
+    background: #252525;
+    height: 34px;
+    width: 34px;
+    display: grid;
+    place-items: center;
+    color: #9a9a9a;
+}
+
+.outliner-bottom strong
+{
+    display: block;
+    font-size: 11px;
+    font-weight: 500;
+    color: #bbbbbb;
+}
+
+.outliner-bottom div > span
+{
+    display: block;
+    font-size: 10px;
+    color: #6e6e6e;
+    margin-top: 3px;
+}
+
+/*------------------------------------------------------------------------------------------------------------------------------------------
+                                                                VIEWPORT
+------------------------------------------------------------------------------------------------------------------------------------------*/
+
+#viewport-column
+{
+    grid-area: viewport;
+    background: #0c0c0c;
+}
+
+.viewport-tabs .scene-pill
+{
+    margin: 0 auto;
+    align-self: center;
+    font-size: 11px;
+    color: #9a9a9a;
+    padding: 4px 28px;
+    border-radius: 0 0 14px 14px;
+    background: #1a1a1a;
+    border: 1px solid #262626;
+    border-top: 0;
+}
+
+.viewport-bar
+{
+    flex: none;
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    height: 52px;
+    padding: 0 14px;
+    background: var(--column);
+    border-bottom: 1px solid var(--edge);
+}
+
+.viewport-bar .scene-heading
+{
+    display: flex;
+    flex-direction: column;
+    margin-right: 6px;
+}
+
+.viewport-bar .scene-heading strong
+{
+    font-size: 13px;
+    font-weight: 500;
+}
+
+.viewport-bar .scene-heading span
+{
+    font-size: 9px;
+    color: #707070;
+}
+
+.live-pill
+{
+    font-size: 9px;
+    letter-spacing: 1.2px;
+    color: #c9a24a;
+    border: 1px solid #5a4a24;
+    background: #2a2416;
+    border-radius: 5px;
+    padding: 3px 7px;
+}
+
+.bar-fill
+{
+    flex: 1;
+}
+
+.icon-button
+{
+    display: grid;
+    place-items: center;
+    width: 34px;
+    height: 34px;
+    border-radius: 50%;
+    background: #1d1d1d;
+    border: 1px solid #2c2c2c;
+    color: #a9a9a9;
+}
+
+.icon-button:hover, .icon-button.active
+{
+    background: #2a2a2a;
+    color: #f0f0f0;
+    border-color: #444;
+}
+
+.icon-button.active
+{
+    box-shadow: inset 0 0 0 1px #ffffff10;
+    color: var(--on);
+}
+
+#stage
+{
+    position: relative;
+    flex: 1;
+    min-height: 0;
+    overflow: hidden;
+}
+
+#viewport
+{
+    width: 100%;
+    height: 100%;
+    display: block;
+    cursor: grab;
+    touch-action: none;
+}
+
+.capture
+{
+    position: absolute;
+    inset: 0;
+    width: 100%;
+    height: 100%;
+    pointer-events: none;
+}
+
+.capture:not([width])
+{
+    display: none;
+}
+
+#hud
+{
+    position: absolute;
+    top: 12px;
+    left: 12px;
+    padding: 10px 34px 10px 13px;
+    background: rgba(16, 16, 16, 0.78);
+    border: 1px solid #2c2c2c;
+    border-radius: 12px;
+    backdrop-filter: blur(6px);
+    font: 11px/1.5 var(--mono);
+    color: #cfcfcf;
+    pointer-events: none;
+    max-width: calc(100% - 24px);
+}
+
+#hud-text
+{
+    font: inherit;
+    white-space: pre;
+}
+
+.overlay-close
+{
+    position: absolute;
+    top: 6px;
+    right: 6px;
+    width: 20px;
+    height: 20px;
+    border-radius: 6px;
+    background: #1d1d1d;
+    border: 1px solid #333;
+    color: #8f8f8f;
+    font-size: 13px;
+    line-height: 17px;
+    pointer-events: auto;
+    z-index: 2;
+}
+
+.overlay-close:hover
+{
+    color: #f0f0f0;
+    border-color: #555;
+}
+
+#inset-frame
+{
+    position: absolute;
+    pointer-events: none;
+}
+
+#inset-legend
+{
+    position: absolute;
+    top: calc(100% + 6px);
+    right: 0;
+    width: max-content;
+    max-width: 46vw;
+    padding: 4px 8px;
+    background: rgba(16, 16, 16, 0.8);
+    border-radius: 8px;
+    font: 10px/1.4 var(--mono);
+    color: var(--muted);
+}
+
+#overlay-dock
+{
+    position: absolute;
+    right: 12px;
+    bottom: 12px;
+    display: flex;
+    gap: 6px;
+    z-index: 10;
+}
+
+#overlay-dock button
+{
+    background: rgba(22, 22, 22, 0.92);
+    border: 1px solid #333;
+    border-radius: 8px;
+    padding: 6px 10px;
+    font-size: 10px;
+    color: #cfcfcf;
+}
+
+#overlay-dock button:hover
+{
+    border-color: #555;
+}
+
+#overlay-notice, #event-notice
+{
+    position: absolute;
+    left: 50%;
+    bottom: 18px;
+    transform: translateX(-50%);
+    padding: 7px 14px;
+    background: rgba(18, 18, 18, 0.9);
+    border: 1px solid #333;
+    border-radius: 10px;
+    font-size: 11px;
+    color: #bdbdbd;
+    pointer-events: none;
+    z-index: 10;
+}
+
+#event-notice
+{
+    bottom: auto;
+    top: 14px;
+    color: #f0d9a8;
+    border-color: #5a4a24;
+}
+
+#bring-up
+{
+    position: absolute;
+    inset: 0;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 12px;
+    background: rgba(10, 10, 10, 0.95);
+    z-index: 20;
+}
+
+#bring-up h2
+{
+    font-size: 15px;
+    font-weight: 500;
+    color: #e2e2e2;
+}
+
+.bring-up-caption
+{
+    font-size: 11px;
+    color: var(--muted);
+}
+
+.bring-up-bar
+{
+    width: 360px;
+    height: 3px;
+    background: #2a2a2a;
+    border-radius: 2px;
+    overflow: hidden;
+}
+
+.bring-up-bar > div
+{
+    width: 0%;
+    height: 100%;
+    background: #d9d9d9;
+    transition: width 0.2s;
+}
+
+#failure
+{
+    position: absolute;
+    left: 12px;
+    bottom: 12px;
+    max-width: 70%;
+    max-height: 40%;
+    overflow: auto;
+    padding: 10px 14px;
+    background: rgba(40, 12, 14, 0.94);
+    border: 1px solid var(--fail);
+    border-radius: 10px;
+    font: 11px/1.45 var(--mono);
+    color: #ffd5d9;
+    z-index: 30;
+    white-space: pre-wrap;
+}
+
+/*------------------------------------------------------------------------------------------------------------------------------------------
+                                                                INSPECTOR
+------------------------------------------------------------------------------------------------------------------------------------------*/
+
+#inspector
+{
+    grid-area: inspector;
+    border-left: 1px solid var(--edge);
+    background: radial-gradient(ellipse at 80% 0%, #1b1b1b 0%, #171717 42%, #141414 100%);
+}
+
+.inspector-top
+{
+    flex: none;
+    height: 44px;
+    padding: 0 18px;
+    border-bottom: 1px solid var(--edge);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    font-size: 11px;
+}
+
+.inspector-top .crumbs
+{
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    color: #bfbfbf;
+}
+
+.inspector-top .crumbs span, .inspector-top .crumbs .glyph
+{
+    color: #717171;
+}
+
+.inspector-top .save-status
+{
+    display: flex;
+    align-items: center;
+    gap: 6px;
