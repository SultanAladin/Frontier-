new file mode 100644
index 0000000..8cbbf4d
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/SurfaceCardDepot.js
@@ -0,0 +1,383 @@
+//============================================================================================================================================
+//                                                           SURFACECARDDEPOT.JS
+//============================================================================================================================================
+// 🧩 The surface cache: oriented cards per occupant in one texel space, captured once, relit by a scheduled tile budget.
+
+import { OccupantRole, VertexStride } from "./FacetStructure.js";
+
+const MinimumCardTexels = 4;     // [texel] - shortest card edge
+const MaximumCardTexels = 256;   // [texel] - longest card edge
+const CardStride        = 48;    // [B]     - CardRecord
+
+export class SurfaceCardDepot
+{
+    // 📝 Configuration: Extent (card texel space edge), DensityScale, TileBudget (8×8 tiles relit per frame beyond the
+    //    moving occupants' tiles, which are relit every frame).
+    constructor(Exchange, Shaders, Configuration)
+    {
+        this.Exchange      = Exchange;
+        this.Shaders       = Shaders;
+        this.Configuration = Configuration;
+        this.Cards         = [];
+        this.DynamicTiles  = [];
+        this.StaticTiles   = [];
+        this.Cursor        = 0;
+        this.WarmFrames    = 6;
+        this.OccupantTiles = [];
+        this.PriorityTiles = [];
+        this.PriorityFrames = 0;
+        this.ScheduledTiles = 0;
+        this.OccupiedTexels = 0;
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                               CARD ALLOCATION
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 Six inward-looking cards on the faces of each occupant's local card bounds (one +Z card for a ground tile),
+    //    sized by texel density and rounded to whole 4×4 radiosity sites, then shelf-packed. Should the packing
+    //    overflow the texel space, every density is lowered together and the packing repeated.
+    AllocateCards(Scene)
+    {
+        let DensityScale = this.Configuration.DensityScale;
+        for (let Attempt = 0; Attempt < 12; ++Attempt)
+        {
+            this.Cards = [];
+            for (let Index = 0; Index < Scene.Occupants.length; ++Index)
+            {
+                const Occupant = Scene.Occupants[Index];
+                Occupant.FirstCard = this.Cards.length;
+                Occupant.CardCount = 0;
+                if (!(Occupant.Roles & OccupantRole.Cards))
+                    continue;
+                const Minimum = Occupant.CardMinimum.slice();
+                const Maximum = Occupant.CardMaximum.slice();
+                const Ground  = !(Occupant.Roles & OccupantRole.Distance);
+                if (!Ground)
+                {
+                    for (let Axis = 0; Axis < 3; ++Axis)
+                    {
+                        const Grow = Math.max(0.01, 0.01 * (Maximum[Axis] - Minimum[Axis]));
+                        Minimum[Axis] -= Grow;
+                        Maximum[Axis] += Grow;
+                    }
+                }
+                const Axes = Ground ? [4] : [0, 1, 2, 3, 4, 5];
+                for (const Axis of Axes)
+                {
+                    const DepthAxis = Axis >> 1;
+                    const AcrossU = (DepthAxis + 1) % 3, AcrossV = (DepthAxis + 2) % 3;
+                    const Density = Occupant.CardDensity * DensityScale;
+                    const Size = (Length) => Math.ceil(Math.min(MaximumCardTexels,
+                                                       Math.max(MinimumCardTexels, Math.round(Length * Density))) / 4) * 4;
+                    this.Cards.push({ LocalMinimum: Minimum, LocalMaximum: Maximum, Axis, Occupant: Index,
+                                      TexelExtent: [Size(Maximum[AcrossU] - Minimum[AcrossU]), Size(Maximum[AcrossV] - Minimum[AcrossV])],
+                                      TexelOrigin: [0, 0] });
+                    Occupant.CardCount++;
+                }
+            }
+            if (this.PackCards())
+            {
+                this.DensityScaleUsed = DensityScale;
+                break;
+            }
+            DensityScale *= 0.8;
+            if (Attempt === 11)
+                throw new Error("Surface cards do not fit the card texel space");
+        }
+
+        this.GroundFirstCard = Scene.Occupants[Scene.GroundTiles.First].FirstCard;
+        this.GroundStripCard = Scene.Occupants[Scene.GroundTiles.Strips[0]].FirstCard;
+
+        this.OccupiedTexels = 0;
+        this.TileTotal = 0;
+        this.OccupantTiles = Scene.Occupants.map(() => []);
+        this.Cards.forEach((Card, CardIndex) =>
+        {
+            this.OccupiedTexels += Card.TexelExtent[0] * Card.TexelExtent[1];
+            for (let TileY = 0; TileY < Math.ceil(Card.TexelExtent[1] / 8); ++TileY)
+            {
+                for (let TileX = 0; TileX < Math.ceil(Card.TexelExtent[0] / 8); ++TileX)
+                {
+                    this.OccupantTiles[Card.Occupant].push([CardIndex, (TileY << 16) | TileX]);
+                    this.TileTotal++;
+                }
+            }
+        });
+        this.RebuildTileLists(Scene);
+    }
+
+    // 📝 The relighting lists hold only enabled occupants: moving ones every frame, static ones round-robin. A disabled
+    //    stress slot keeps its captured cards but costs no lighting work until it is enabled again. A Dynamic occupant
+    //    with Moving false (a cone at rest) is relit round-robin like a static one until it is knocked.
+    RebuildTileLists(Scene)
+    {
+        this.DynamicTiles = [];
+        this.StaticTiles = [];
+        Scene.Occupants.forEach((Occupant, Index) =>
+        {
+            if (Occupant.Inactive)
+                return;
+            const Target = ((Occupant.Roles & OccupantRole.Dynamic) && Occupant.Moving !== false) ? this.DynamicTiles : this.StaticTiles;
+            for (const Assignment of this.OccupantTiles[Index])
+                Target.push(Assignment);
+        });
+        if (this.Cursor >= this.StaticTiles.length)
+            this.Cursor = 0;
+    }
+
+    // 📝 Newly enabled occupants are relit every frame for a few frames, so they arrive lit and with a few radiosity
+    //    bounces instead of waiting for the round-robin to reach them.
+    WarmOccupants(Scene, Indices, Frames = 6)
+    {
+        const Tiles = [];
+        for (const Index of Indices)
+        {
+            // 📝 Moving occupants are relit every frame already; listing them twice would schedule a tile twice.
+            if ((Scene.Occupants[Index].Roles & OccupantRole.Dynamic) && Scene.Occupants[Index].Moving !== false)
+                continue;
+            for (const Assignment of this.OccupantTiles[Index])
+                Tiles.push(Assignment);
+        }
+        this.PriorityTiles = Tiles;
+        this.PriorityFrames = Tiles.length > 0 ? Frames : 0;
+    }
+
+    PackCards()
+    {
+        const Extent = this.Configuration.Extent;
+        const Order = this.Cards.map((Card, Index) => Index)
+                                .sort((Left, Right) => this.Cards[Right].TexelExtent[1] - this.Cards[Left].TexelExtent[1]);
+        let ShelfX = 0, ShelfY = 0, ShelfHeight = 0;
+        for (const Index of Order)
+        {
+            const Card = this.Cards[Index];
+            const [Width, Height] = Card.TexelExtent;
+            if (ShelfX + Width > Extent)
+            {
+                ShelfY += ShelfHeight;
+                ShelfX = 0;
+                ShelfHeight = 0;
+            }
+            if (ShelfY + Height > Extent)
+                return false;
+            Card.TexelOrigin = [ShelfX, ShelfY];
+            ShelfX += Width;
+            ShelfHeight = Math.max(ShelfHeight, Height);
+        }
+        return true;
+    }
+
+    EncodeCardRecords()
+    {
+        const Bytes = new ArrayBuffer(Math.max(1, this.Cards.length) * CardStride);
+        const Scalars = new Float32Array(Bytes);
+        const Integers = new Uint32Array(Bytes);
+        this.Cards.forEach((Card, Index) =>
+        {
+            const Offset = Index * (CardStride / 4);
+            Scalars.set(Card.LocalMinimum, Offset);
+            Integers[Offset + 3] = Card.Axis;
+            Scalars.set(Card.LocalMaximum, Offset + 4);
+            Integers[Offset + 7] = Card.Occupant;
+            Integers[Offset + 8] = Card.TexelOrigin[0];
+            Integers[Offset + 9] = Card.TexelOrigin[1];
+            Integers[Offset + 10] = Card.TexelExtent[0];
+            Integers[Offset + 11] = Card.TexelExtent[1];
+        });
+        return Scalars;
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                  RESOURCES
+    //--------------------------------------------------------------------------------------------------------------------
+
+    async ConstructResources(FrameRecords, OccupantRecords, MaterialRecords, DistanceLayout)
+    {
+        const Extent = this.Configuration.Extent;
+        const Usage = GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING;
+        const Construct = (Label, Format, Extra = 0) =>
+            this.Exchange.ConstructTexture({ label: Label, size: [Extent, Extent], format: Format, usage: Usage | Extra });
+        this.AlbedoTexture   = Construct("Card albedo", "rgba8unorm-srgb");
+        this.NormalTexture   = Construct("Card normal", "rgba8unorm");
+        this.EmissionTexture = Construct("Card emission", "rgba16float");
+        this.DepthTexture    = Construct("Card depth", "r16float");
+        this.DirectTexture   = this.Exchange.ConstructTexture({ label: "Card direct irradiance", size: [Extent, Extent], format: "rgba16float",
+                                                                usage: GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING });
+        this.FinalTexture    = this.Exchange.ConstructTexture({ label: "Card final radiance", size: [Extent, Extent], format: "rgba16float",
+                                                                usage: GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING });
+        this.Views = {
+            Albedo:   this.AlbedoTexture.createView(),
+            Normal:   this.NormalTexture.createView(),
+            Emission: this.EmissionTexture.createView(),
+            Depth:    this.DepthTexture.createView(),
+            Direct:   this.DirectTexture.createView(),
+            Final:    this.FinalTexture.createView()
+        };
+        this.SiteStride   = Extent / 4;
+        this.CardRecords  = this.Exchange.ConstructRecordsFrom(this.EncodeCardRecords(), GPUBufferUsage.STORAGE, "Card records");
+        this.SiteRecords  = this.Exchange.ConstructRecords(this.SiteStride * this.SiteStride * 16, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST, "Radiosity sites");
+        // 📝 Every tile once, plus the warm-up list, which may repeat tiles the round-robin also picks this frame.
+        const TileCapacity = Math.max(1, 2 * this.TileTotal);
+        this.TileRecords  = this.Exchange.ConstructRecords(TileCapacity * 8, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST, "Card tiles");
+        this.WorkRecords  = this.Exchange.ConstructRecords(16, GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST, "Card work");
+
+        const Compute = GPUShaderStage.COMPUTE;
+        this.DirectLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "StorageRead", "StorageRead", "StorageRead", "Uniform", "Texture2D", "Texture2D", "StorageTexture2D:rgba16float"], Compute, "Card direct");
+        this.RadiosityLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "StorageRead", "Uniform", "Texture2D", "Storage"], Compute, "Card radiosity");
+        this.FinalLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "StorageRead", "StorageRead", "Uniform", "Texture2D", "Texture2D", "Texture2D", "Texture2D", "StorageRead",
+             "StorageTexture2D:rgba16float"], Compute, "Card final");
+        this.SamplingLayout = this.Exchange.ConstructDescriptorLayout(
+            ["StorageRead", "StorageRead", "Texture2D", "Texture2D", "Texture2D", "Sampler"], Compute | GPUShaderStage.FRAGMENT, "Card sampling");
+        this.EmptyLayout = this.Exchange.ConstructDescriptorLayout([], Compute, "Empty");
+
+        this.DirectGroup = this.Exchange.ConstructDescriptorGroup(this.DirectLayout,
+            [FrameRecords, this.CardRecords, OccupantRecords, this.TileRecords, this.WorkRecords, this.Views.Normal, this.Views.Depth, this.Views.Direct]);
+        this.RadiosityGroup = this.Exchange.ConstructDescriptorGroup(this.RadiosityLayout,
+            [FrameRecords, this.TileRecords, this.WorkRecords, this.Views.Normal, this.SiteRecords]);
+        this.FinalGroup = this.Exchange.ConstructDescriptorGroup(this.FinalLayout,
+            [FrameRecords, this.CardRecords, this.TileRecords, this.WorkRecords, this.Views.Albedo, this.Views.Emission, this.Views.Direct,
+             this.Views.Depth, this.SiteRecords, this.Views.Final]);
+
+        this.DirectProgram    = await this.Shaders.ConstructComputeProgram("CardDirect.wgsl", "IntegrateCardDirect", [this.DirectLayout, DistanceLayout]);
+        this.RadiosityProgram = await this.Shaders.ConstructComputeProgram("CardRadiosity.wgsl", "IntegrateCardRadiosity",
+                                                                           [this.RadiosityLayout, DistanceLayout, this.SamplingLayout]);
+        this.FinalProgram     = await this.Shaders.ConstructComputeProgram("CardFinal.wgsl", "IntegrateCardFinal", [this.FinalLayout]);
+
+        this.CaptureLayout = this.Exchange.ConstructDescriptorLayout(["StorageRead", "StorageRead", "StorageRead"],
+                                                                     GPUShaderStage.VERTEX | GPUShaderStage.FRAGMENT, "Card capture");
+        this.CaptureGroup = this.Exchange.ConstructDescriptorGroup(this.CaptureLayout, [this.CardRecords, OccupantRecords, MaterialRecords]);
+        this.CaptureProgram = await this.Shaders.ConstructRasterProgram("CardCapture.wgsl", {
+            VertexEntry: "CaptureVertex", FragmentEntry: "CaptureFragment",
+            VertexLayouts: [{ arrayStride: VertexStride, attributes: [
+                { shaderLocation: 0, offset: 0,  format: "float32x3" },
+                { shaderLocation: 1, offset: 12, format: "uint32" },
+                { shaderLocation: 2, offset: 16, format: "float32x3" }] }],
+            Primitive: { topology: "triangle-list", cullMode: "none" },
+            DepthStencil: { format: "depth32float", depthWriteEnabled: true, depthCompare: "less" },
+            Targets: [{ format: "rgba8unorm-srgb" }, { format: "rgba8unorm" }, { format: "rgba16float" }, { format: "r16float" }]
+        }, [this.CaptureLayout]);
+    }
+
+    ConstructSamplingGroup(OccupantRecords, SkyView, SkySampler)
+    {
+        return this.Exchange.ConstructDescriptorGroup(this.SamplingLayout,
+            [OccupantRecords, this.CardRecords, this.Views.Depth, this.Views.Final, SkyView, SkySampler]);
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                   CAPTURE
+    //--------------------------------------------------------------------------------------------------------------------
+
+    CaptureCards(Scene, VertexRecords)
+    {
+        const Device = this.Exchange.Device;
+        const Extent = this.Configuration.Extent;
+        const DepthAttachment = this.Exchange.ConstructTexture({ label: "Card capture depth", size: [Extent, Extent],
+                                                                 format: "depth32float", usage: GPUTextureUsage.RENDER_ATTACHMENT });
+        const Encoder = Device.createCommandEncoder({ label: "Card capture" });
+        const Clear = (View, Value) => ({ view: View, clearValue: Value, loadOp: "clear", storeOp: "store" });
+        const Pass = Encoder.beginRenderPass({
+            label: "Card capture",
+            colorAttachments: [Clear(this.Views.Albedo, [0, 0, 0, 0]), Clear(this.Views.Normal, [0.5, 0.5, 1, 0]),
+                               Clear(this.Views.Emission, [0, 0, 0, 0]), Clear(this.Views.Depth, [4, 0, 0, 0])],
+            depthStencilAttachment: { view: DepthAttachment.createView(), depthClearValue: 1.0, depthLoadOp: "clear", depthStoreOp: "discard" }
+        });
+        Pass.setPipeline(this.CaptureProgram);
+        Pass.setBindGroup(0, this.CaptureGroup);
+        Pass.setVertexBuffer(0, VertexRecords);
+        this.Cards.forEach((Card, Index) =>
+        {
+            const Set = Scene.FacetSets[Scene.Occupants[Card.Occupant].FacetSet];
+            Pass.setViewport(Card.TexelOrigin[0], Card.TexelOrigin[1], Card.TexelExtent[0], Card.TexelExtent[1], 0.0, 1.0);
+            Pass.setScissorRect(Card.TexelOrigin[0], Card.TexelOrigin[1], Card.TexelExtent[0], Card.TexelExtent[1]);
+            Pass.draw(Set.VertexCount, 1, Set.FirstVertex, Index);
+        });
+        Pass.end();
+        Device.queue.submit([Encoder.finish()]);
+        DepthAttachment.destroy();
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                              LIGHTING SCHEDULE
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 A step change of the light (a preset, day to night) would otherwise drain out of the radiosity sites at the
+    //    weight floor over seconds. The sites are cleared, so their next gather is taken whole, and every tile is relit.
+    InvalidateLighting()
+    {
+        this.Exchange.Device.queue.writeBuffer(this.SiteRecords, 0, new Float32Array(this.SiteStride * this.SiteStride * 4));
+        this.WarmFrames = Math.max(this.WarmFrames, 3);
+    }
+
+    // 📝 Moving occupants' tiles every frame; static tiles round-robin within the budget. The first WarmFrames relight
+    //    everything so the depot starts lit and its radiosity has taken several bounces before the first image.
+    ScheduleTiles(TileBudget)
+    {
+        const Scheduled = this.DynamicTiles.slice();
+        if (this.WarmFrames > 0)
+        {
+            Scheduled.push(...this.StaticTiles);
+            this.WarmFrames--;
+        }
+        else
+        {
+            // 📝 A tile must not be scheduled twice in one frame: the radiosity pass folds into its sites in place.
+            const Priority = this.PriorityFrames > 0 ? this.PriorityTiles : [];
+            const Claimed = new Set(Priority.map((Assignment) => Assignment[0] * 4194304 + Assignment[1]));
+            Scheduled.push(...Priority);
+            if (this.PriorityFrames > 0)
+                this.PriorityFrames--;
+            const Budget = Math.min(this.StaticTiles.length, Math.max(0, TileBudget));
+            for (let Index = 0; Index < Budget; ++Index)
+            {
+                const Assignment = this.StaticTiles[this.Cursor];
+                this.Cursor = (this.Cursor + 1) % this.StaticTiles.length;
+                if (!Claimed.has(Assignment[0] * 4194304 + Assignment[1]))
+                    Scheduled.push(Assignment);
+            }
+        }
+        const Packed = new Uint32Array(Scheduled.length * 2);
+        Scheduled.forEach((Assignment, Index) =>
+        {
+            Packed[Index * 2] = Assignment[0];
+            Packed[Index * 2 + 1] = Assignment[1];
+        });
+        this.ScheduledTiles = Scheduled.length;
+        const Device = this.Exchange.Device;
+        if (Scheduled.length > 0)
+            Device.queue.writeBuffer(this.TileRecords, 0, Packed);
+        const Work = new ArrayBuffer(16);
+        new Uint32Array(Work, 0, 2).set([Scheduled.length, this.SiteStride]);
+        new Float32Array(Work, 8, 2).set([0.15, 0.35]);
+        Device.queue.writeBuffer(this.WorkRecords, 0, Work);
+    }
+
+    RecordLighting(Encoder, DistanceGroup, SamplingGroup, RadiosityEnabled, TimestampWrites)
+    {
+        if (this.ScheduledTiles === 0)
+            return;
+        const GroupsX = Math.min(this.ScheduledTiles, 65535);
+        const GroupsY = Math.ceil(this.ScheduledTiles / 65535);
+        const Pass = Encoder.beginComputePass({ label: "Card lighting", timestampWrites: TimestampWrites });
+        Pass.setPipeline(this.DirectProgram);
+        Pass.setBindGroup(0, this.DirectGroup);
+        Pass.setBindGroup(1, DistanceGroup);
+        Pass.dispatchWorkgroups(GroupsX, GroupsY);
+        if (RadiosityEnabled)
+        {
+            Pass.setPipeline(this.RadiosityProgram);
+            Pass.setBindGroup(0, this.RadiosityGroup);
+            Pass.setBindGroup(1, DistanceGroup);
+            Pass.setBindGroup(2, SamplingGroup);
+            Pass.dispatchWorkgroups(GroupsX, GroupsY);
+        }
+        Pass.setPipeline(this.FinalProgram);
+        Pass.setBindGroup(0, this.FinalGroup);
+        Pass.dispatchWorkgroups(GroupsX, GroupsY);
+        Pass.end();
+    }
+}
diff --git a/Experimental/IlluminationHost/Source/SurfaceProjection.js b/Experimental/IlluminationHost/Source/SurfaceProjection.js
new file mode 100644
index 0000000..6dd0ffc
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/SurfaceProjection.js
@@ -0,0 +1,103 @@
+//============================================================================================================================================
+//                                                           SURFACEPROJECTION.JS
+//============================================================================================================================================
+// 🧩 Primary visibility (depth, attributes, motion) and the direct sun radiance resolved over it, sized to the screen.
+
+import { VertexStride } from "./FacetStructure.js";
+
+export class SurfaceProjection
+{
+    constructor(Exchange, Shaders)
+    {
+        this.Exchange = Exchange;
+        this.Shaders  = Shaders;
+        this.Extent   = [0, 0];
+    }
+
+    // 📝 TyreMarks: the TyreMarkDepot whose deposit the raster reads for the road families.
+    // 📝 Effects (EffectSequence) shares this pass: its record masks the car here, and its cubes draw after the runs.
+    // 📝 VehicleRecords: the VehicleRecord the vertex stage deforms the tyres and turns the steering wheel by.
+    async ConstructPrograms(FrameRecords, OccupantRecords, MaterialRecords, DistanceLayout, TyreMarks, Effects, VehicleRecords)
+    {
+        this.FrameRecords    = FrameRecords;
+        this.OccupantRecords = OccupantRecords;
+        this.MaterialRecords = MaterialRecords;
+        this.Effects         = Effects;
+        this.RasterLayout = this.Exchange.ConstructDescriptorLayout(["Uniform", "StorageRead", "Texture2D", "Sampler", "Uniform", "StorageRead"],
+                                                                    GPUShaderStage.VERTEX | GPUShaderStage.FRAGMENT, "Surface raster");
+        this.RasterGroup = this.Exchange.ConstructDescriptorGroup(this.RasterLayout, [FrameRecords, OccupantRecords, TyreMarks.View, TyreMarks.Sampler,
+                                                                                      Effects.Records, VehicleRecords]);
+        this.RasterProgram = await this.Shaders.ConstructRasterProgram("SurfaceRaster.wgsl", {
+            VertexEntry: "SurfaceVertex", FragmentEntry: "SurfaceFragment",
+            VertexLayouts: [{ arrayStride: VertexStride, attributes: [
+                { shaderLocation: 0, offset: 0,  format: "float32x3" },
+                { shaderLocation: 1, offset: 12, format: "uint32" },
+                { shaderLocation: 2, offset: 16, format: "float32x3" },
+                { shaderLocation: 3, offset: 28, format: "uint32" }] }],
+            Primitive: { topology: "triangle-list", cullMode: "none" },
+            DepthStencil: { format: "depth32float", depthWriteEnabled: true, depthCompare: "greater" },
+            Targets: [{ format: "rgba16float" }, { format: "rg16float" }]
+        }, [this.RasterLayout]);
+        this.DirectLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "StorageRead", "Texture2D", "TextureDepth2D", "TextureDepth2DLayered", "SamplerComparison", "Uniform", "Texture2D",
+             "Sampler", "StorageTexture2D:rgba16float"], GPUShaderStage.COMPUTE, "Direct radiance");
+        // 📝 The direct pass traverses the scene distance field only to shadow a tyre fire's light (FireIllumination.wgsl).
+        this.DirectProgram = await this.Shaders.ConstructComputeProgram("DirectRadiance.wgsl", "IntegrateDirectRadiance",
+                                                                        [this.DirectLayout, DistanceLayout]);
+    }
+
+    ConstructTargets(Width, Height, Shadow, Atmosphere)
+    {
+        this.Extent = [Width, Height];
+        for (const Texture of [this.DepthTexture, this.AttributeTexture, this.MotionTexture, this.DirectTexture])
+            if (Texture) Texture.destroy();
+        const Attachment = GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING;
+        this.DepthTexture     = this.Exchange.ConstructTexture({ label: "Surface depth", size: [Width, Height], format: "depth32float", usage: Attachment });
+        this.AttributeTexture = this.Exchange.ConstructTexture({ label: "Surface attributes", size: [Width, Height], format: "rgba16float", usage: Attachment });
+        this.MotionTexture    = this.Exchange.ConstructTexture({ label: "Surface motion", size: [Width, Height], format: "rg16float", usage: Attachment });
+        this.DirectTexture    = this.Exchange.ConstructTexture({ label: "Direct radiance", size: [Width, Height], format: "rgba16float",
+                                                                 usage: GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING });
+        this.Views = {
+            Depth:      this.DepthTexture.createView(),
+            Attributes: this.AttributeTexture.createView(),
+            Motion:     this.MotionTexture.createView(),
+            Direct:     this.DirectTexture.createView()
+        };
+        this.DirectGroup = this.Exchange.ConstructDescriptorGroup(this.DirectLayout,
+            [this.FrameRecords, this.MaterialRecords, this.Views.Attributes, this.Views.Depth, Shadow.LayeredView, Shadow.ComparisonSampler,
+             Shadow.ReceiverRecords, Atmosphere.SkyView, Atmosphere.SkySampler, this.Views.Direct]);
+    }
+
+    RecordSurface(Encoder, Scene, VertexRecords, TimestampWrites)
+    {
+        const Pass = Encoder.beginRenderPass({
+            label: "Surface projection",
+            colorAttachments: [
+                { view: this.Views.Attributes, clearValue: [0, 0, 0, 0], loadOp: "clear", storeOp: "store" },
+                { view: this.Views.Motion, clearValue: [0, 0, 0, 0], loadOp: "clear", storeOp: "store" }],
+            depthStencilAttachment: { view: this.Views.Depth, depthClearValue: 0.0, depthLoadOp: "clear", depthStoreOp: "store" },
+            timestampWrites: TimestampWrites
+        });
+        Pass.setPipeline(this.RasterProgram);
+        Pass.setBindGroup(0, this.RasterGroup);
+        Pass.setVertexBuffer(0, VertexRecords);
+        for (const Run of Scene.DrawRuns)
+        {
+            const Set = Scene.FacetSets[Run.FacetSet];
+            Pass.draw(Set.VertexCount, Run.Count, Set.FirstVertex, Run.First);
+        }
+        if (this.Effects)
+            this.Effects.Record(Pass);
+        Pass.end();
+    }
+
+    RecordDirect(Encoder, DistanceGroup, TimestampWrites)
+    {
+        const Pass = Encoder.beginComputePass({ label: "Direct radiance", timestampWrites: TimestampWrites });
+        Pass.setPipeline(this.DirectProgram);
+        Pass.setBindGroup(0, this.DirectGroup);
+        Pass.setBindGroup(1, DistanceGroup);
+        Pass.dispatchWorkgroups(Math.ceil(this.Extent[0] / 8), Math.ceil(this.Extent[1] / 8));
+        Pass.end();
+    }
+}
diff --git a/Experimental/IlluminationHost/Source/TrainingSequence.js b/Experimental/IlluminationHost/Source/TrainingSequence.js
new file mode 100644
index 0000000..fb9d115
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/TrainingSequence.js
@@ -0,0 +1,496 @@
+//============================================================================================================================================
+//                                                           TRAININGSEQUENCE.JS
+//============================================================================================================================================
+// 🧩 The training arena's drills: timing gates, penalties, scores and best times — Apex Legends' Firing Range, for driving.
+
+// 📝 Every station is live all the time: drive through a start gate (or into a zone) and its drill starts, the HUD
+//    shows it running, and the result lands in the HUD, the Training page and — when it beats the best — the
+//    browser's storage. Starting a drill from the Training page derezzes the car to its start and rezzes the cones
+//    the last run knocked over back onto their marks.
+//
+//      launch   62 m sprint (60 ft and 0–100 splits), trap speed at the brake line; counts only stopped in the box
+//      slalom   gate to gate, +1 s per displaced cone
+//      moose    ISO 3888-2 lane change: entry speed and a clean pass (any cone fails it)
+//      bowling  pins down, 3 s after the foul line (a strike is all 15)
+//      spin     full turns inside the box without touching a cone or leaving it
+//      drift    angle × speed × time while sliding, chained with a growing multiplier; a cone hit loses the chain
+//      skidpad  the same score on the 14 m ring
+//      jump     airtime and distance past the lip
+//      smash    props broken and impact energy, alley entrance to exit
+//      burnout  seconds of held burnout and the hottest tyre
+
+import { TrainingDrills } from "./LevelStructure.js";
+import { RotateVector, LengthVector } from "./TransformProjection.js";
+
+const StorageKey = "FrontierRange.Best";
+
+export class TrainingSequence
+{
+    constructor(Host)
+    {
+        this.Host    = Host;
+        this.Drills  = TrainingDrills;
+        this.Active  = null;    // { Drill, Phase, Clock, ... }
+        this.Results = {};      // drill id → [latest first]
+        this.Best    = this.RetrieveBest();
+        this.Previous = null;   // car centre last frame
+        this.Clock   = 0.0;
+        this.ConstructHud();
+    }
+
+    RetrieveBest()
+    {
+        try { return JSON.parse(localStorage.getItem(StorageKey) || "{}") || {}; }
+        catch { return {}; }
+    }
+
+    StoreBest()
+    {
+        try { localStorage.setItem(StorageKey, JSON.stringify(this.Best)); }
+        catch { /* storage unavailable: best times last the session */ }
+    }
+
+    QueryActiveDrill()
+    {
+        return this.Active ? this.Active.Drill : null;
+    }
+
+    QueryDrill(Id)
+    {
+        return this.Drills.find((Drill) => Drill.Id === Id);
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                  STARTING
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 From the Training page: derez to the start, rez the drill's cones, arm it.
+    StartDrill(Id)
+    {
+        const Drill = this.QueryDrill(Id);
+        if (!Drill)
+            return;
+        this.Host.Cones.ResetCones(Drill.Groups, true);
+        this.Arm(Drill);
+        this.Host.TeleportVehicle({ Name: Drill.Name, Position: Drill.Teleport.Position, Yaw: Drill.Teleport.Yaw }, false, () => this.Arm(Drill));
+    }
+
+    Arm(Drill)
+    {
+        this.Active = { Drill, Phase: "armed", Clock: 0.0, Score: 0.0, Chain: 0.0, Multiplier: 1.0, Since: 0.0, Splits: {}, Start: null };
+        this.RefreshHud();
+    }
+
+    Cancel()
+    {
+        this.Active = null;
+        this.RefreshHud();
+    }
+
+    // 📝 R during a drill: back to its start, armed again.
+    OnRespawn()
+    {
+        if (this.Active)
+            this.Arm(this.Active.Drill);
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                    FRAME
+    //--------------------------------------------------------------------------------------------------------------------
+
+    Advance(Seconds)
+    {
+        const Vehicle = this.Host.Vehicle;
+        this.Clock += Seconds;
+        const Position = Vehicle.Position.slice();
+        const Previous = this.Previous || Position;
+        this.Previous = Position;
+        if (this.Host.Recovery && this.Host.Recovery.Busy)
+        {
+            this.RefreshHud();
+            return;
+        }
+        const Forward = RotateVector(Vehicle.Orientation, [1.0, 0.0, 0.0]);
+        const Speed = LengthVector(Vehicle.LinearVelocity);
+        const State = { Vehicle, Position, Previous, Forward, Speed, Seconds };
+        // 📝 Drive into a station and its drill starts on its own.
+        if (!this.Active || this.Active.Phase === "finished")
+            this.DetectStation(State);
+        if (this.Active)
+            this.AdvanceDrill(State);
+        this.RefreshHud();
+    }
+
+    Crossed(Gate, State)
+    {
+        if (!Gate)
+            return false;
+        const Axis = Gate.Axis === "x" ? 0 : 1, Other = 1 - Axis;
+        const Before = State.Previous[Axis] - Gate.At, After = State.Position[Axis] - Gate.At;
+        const Across = State.Position[Other];
+        return Before < 0.0 && After >= 0.0 && Across >= Gate.From && Across <= Gate.To;
+    }
+
+    Within(Zone, Position)
+    {
+        const Minimum = Zone.Minimum, Maximum = Zone.Maximum;
+        return Position[0] >= Minimum[0] && Position[0] <= Maximum[0] && Position[1] >= Minimum[1] && Position[1] <= Maximum[1];
+    }
+
+    DetectStation(State)
+    {
+        for (const Drill of this.Drills)
+        {
+            let Enter = false;
+            if (Drill.Start && Drill.Id !== "launch")
+                Enter = this.Crossed(Drill.Start, State);
+            else if (Drill.Id === "launch")
+                Enter = this.Crossed(Drill.Start, State);
+            else if (Drill.Box)
+                Enter = this.Within(Drill.Box, State.Position) && !this.Within(Drill.Box, State.Previous);
+            else if (Drill.Zone)
+                Enter = this.Within(Drill.Zone, State.Position) && !this.Within(Drill.Zone, State.Previous);
+            else if (Drill.Lip !== undefined)
+                Enter = State.Previous[0] < Drill.Lip && State.Position[0] >= Drill.Lip && Math.abs(State.Position[1]) < 3.4;
+            if (!Enter)
+                continue;
+            this.Arm(Drill);
+            this.Begin(State);
+            return;
+        }
+    }
+
+    // 📝 The clock starts: the gate was crossed (or the zone entered, or the lip left).
+    Begin(State)
+    {
+        const Run = this.Active;
+        Run.Phase = "running";
+        Run.Clock = 0.0;
+        Run.Start = State.Position.slice();
+        Run.EntrySpeed = State.Speed;
+        Run.Hits = this.Host.Cones.CountDisplaced(Run.Drill.Groups);
+        Run.Breaks = this.Host.Fracture.Metrics.Breaks;
+        Run.Yaw = Math.atan2(State.Forward[1], State.Forward[0]);
+        Run.Turned = 0.0;
+        Run.Airborne = false;
+    }
+
+    AdvanceDrill(State)
+    {
+        const Run = this.Active;
+        const Drill = Run.Drill;
+        if (Run.Phase === "armed")
+        {
+            const Gate = Drill.Start;
+            const Starts = (Gate && this.Crossed(Gate, State)) || (Drill.Box && this.Within(Drill.Box, State.Position)) ||
+                           (Drill.Zone && this.Within(Drill.Zone, State.Position)) ||
+                           (Drill.Lip !== undefined && State.Previous[0] < Drill.Lip && State.Position[0] >= Drill.Lip);
+            if (Starts)
+                this.Begin(State);
+            return;
+        }
+        if (Run.Phase !== "running")
+            return;
+        Run.Clock += State.Seconds;
+        const Hits = this.Host.Cones.CountDisplaced(Drill.Groups) - (Run.Hits || 0);
+        switch (Drill.Id)
+        {
+            case "launch":  this.AdvanceLaunch(Run, Drill, State, Hits); break;
+            case "slalom":
+            case "moose":   this.AdvanceGated(Run, Drill, State, Hits); break;
+            case "bowling": this.AdvanceBowling(Run, Drill, State); break;
+            case "spin":    this.AdvanceSpin(Run, Drill, State, Hits); break;
+            case "drift":
+            case "skidpad": this.AdvanceDrift(Run, Drill, State, Hits); break;
+            case "jump":    this.AdvanceJump(Run, Drill, State); break;
+            case "smash":   this.AdvanceSmash(Run, Drill, State); break;
+            case "burnout": this.AdvanceBurnout(Run, Drill, State); break;
+        }
+    }
+
+    AdvanceLaunch(Run, Drill, State, Hits)
+    {
+        const Y = State.Position[1];
+        if (Run.Splits.SixtyFoot === undefined && Y >= Drill.SixtyFoot)
+            Run.Splits.SixtyFoot = Run.Clock;
+        if (Run.Splits.Hundred === undefined && State.Speed >= 100.0 / 3.6)
+            Run.Splits.Hundred = Run.Clock;
+        if (Run.Splits.Trap === undefined && Y >= Drill.Brake)
+        {
+            Run.Splits.Trap = State.Speed * 3.6;
+            Run.Splits.BrakeAt = Run.Clock;
+        }
+        if (Run.Splits.Trap !== undefined && State.Speed < 0.3)
+        {
+            const Stop = Y - Drill.Brake;
+            const Lane = Drill.Lanes.find((X) => Math.abs(State.Position[0] - X) <= Drill.LaneHalf);
+            const InBox = Lane !== undefined && Y >= Drill.StopBox[0] && Y <= Drill.StopBox[1];
+            // 📝 The score is the sprint to the brake line; it counts only if the car then stops inside a stop box.
+            this.Finish({ Primary: Run.Splits.BrakeAt, Unit: "s", Lower: true,
+                          Lines: [`60 ft ${Format(Run.Splits.SixtyFoot)} s`, Run.Splits.Hundred !== undefined ? `0–100 ${Format(Run.Splits.Hundred)} s` : "",
+                                  `trap ${Run.Splits.Trap.toFixed(0)} km/h`, `stopped in ${Stop.toFixed(1)} m${InBox ? " · in the box ✓" : " · missed the box"}`,
+                                  Hits > 0 ? `${Hits} cones` : "clean"].filter(Boolean),
+                          Valid: InBox });
+        }
+        else if (Run.Clock > 40.0 || Math.abs(State.Position[0] - 76.0) > 14.0)
+            this.Finish({ Primary: Run.Clock, Unit: "s", Lines: ["left the strip"], Valid: false });
+    }
+
+    AdvanceGated(Run, Drill, State, Hits)
+    {
+        if (this.Crossed(Drill.Finish, State))
+        {
+            if (Drill.Id === "moose")
+                this.Finish({ Primary: Run.EntrySpeed * 3.6, Unit: "km/h", Lower: false,
+                              Lines: [`entry ${(Run.EntrySpeed * 3.6).toFixed(1)} km/h`, `${Run.Clock.toFixed(2)} s`, Hits > 0 ? `${Hits} cones — failed` : "clean pass ✓"],
+                              Valid: Hits === 0 });
+            else
+                this.Finish({ Primary: Run.Clock + Hits, Unit: "s", Lower: true,
+                              Lines: [`${Run.Clock.toFixed(2)} s`, Hits > 0 ? `+${Hits} s (${Hits} cones)` : "clean ✓"], Valid: true });
+        }
+        else if (Run.Clock > 60.0 || State.Position[1] < Drill.Start.At - 6.0)
+            this.Finish({ Primary: Run.Clock, Unit: "s", Lines: ["abandoned"], Valid: false });
+    }
+
+    AdvanceBowling(Run, Drill, State)
+    {
+        Run.Since += State.Seconds;
+        if (Run.Since > 3.0 && (State.Speed < 1.0 || Run.Since > 6.0))
+        {
+            const Pins = this.Host.Cones.CountDisplaced(Drill.Groups);
+            this.Finish({ Primary: Pins, Unit: "pins", Lower: false,
+                          Lines: [Pins === 15 ? "STRIKE!" : `${Pins} of 15`, `at ${(Run.EntrySpeed * 3.6).toFixed(0)} km/h`], Valid: true });
+        }
+    }
+
+    AdvanceSpin(Run, Drill, State, Hits)
+    {
+        const Yaw = Math.atan2(State.Forward[1], State.Forward[0]);
+        let Delta = Yaw - Run.Yaw;
+        Delta = Math.atan2(Math.sin(Delta), Math.cos(Delta));
+        Run.Yaw = Yaw;
+        Run.Turned += Delta;
+        Run.Score = Math.floor(Math.abs(Run.Turned) / (2.0 * Math.PI));
+        if (Hits > 0 || !this.Within(Drill.Box, State.Position))
+            this.Finish({ Primary: Run.Score, Unit: "spins", Lower: false,
+                          Lines: [`${Run.Score} × 360°`, Hits > 0 ? "touched a cone" : "left the box"], Valid: Run.Score > 0 });
+        else if (Run.Clock > 30.0)
+            this.Finish({ Primary: Run.Score, Unit: "spins", Lower: false, Lines: [`${Run.Score} × 360° in 30 s`], Valid: true });
+    }
+
+    // 📐 Drift score: while the slip angle between heading and velocity exceeds 12° above 20 km/h, angle [°] ×
+    //    speed [m/s] × Δt accrues into the chain, × a multiplier that grows a step every 2 s of unbroken drift (to ×5).
+    //    A second without drifting banks the chain; a cone hit loses it.
+    AdvanceDrift(Run, Drill, State, Hits)
+    {
+        const Velocity = State.Vehicle.LinearVelocity;
+        const Planar = Math.hypot(Velocity[0], Velocity[1]);
+        let Angle = 0.0;
+        if (Planar > 20.0 / 3.6)
+        {
+            const Cosine = (Velocity[0] * State.Forward[0] + Velocity[1] * State.Forward[1]) / (Planar * Math.hypot(State.Forward[0], State.Forward[1]));
+            Angle = Math.acos(Math.max(-1.0, Math.min(1.0, Cosine))) * 180.0 / Math.PI;
+        }
+        Run.Angle = Angle;
+        if (Hits > (Run.LastHits || 0))
+        {
+            Run.Chain = 0.0;
+            Run.Multiplier = 1.0;
+            Run.Drifting = 0.0;
+            Run.LastHits = Hits;
+            this.Host.Shell.Announce("Cone! Chain lost");
+        }
+        if (Angle > 12.0 && Angle < 120.0)
+        {
+            Run.Drifting = (Run.Drifting || 0.0) + State.Seconds;
+            Run.Since = 0.0;
+            Run.Multiplier = Math.min(5.0, 1.0 + Math.floor(Run.Drifting / 2.0));
+            Run.Chain += Angle * Planar * State.Seconds * Run.Multiplier;
+        }
+        else
+        {
+            Run.Since += State.Seconds;
+            if (Run.Since > 1.0 && Run.Chain > 0.0)
+            {
+                Run.Score += Run.Chain;
+                Run.Best = Math.max(Run.Best || 0.0, Run.Chain);
+                Run.Chain = 0.0;
+                Run.Multiplier = 1.0;
+                Run.Drifting = 0.0;
+            }
+        }
+        if (!this.Within(Drill.Zone, State.Position) || Run.Clock > 90.0)
+        {
+            const Total = Run.Score + Run.Chain;
+            this.Finish({ Primary: Math.round(Total), Unit: "pts", Lower: false,
+                          Lines: [`${Math.round(Total)} points`, `best chain ${Math.round(Math.max(Run.Best || 0.0, Run.Chain))}`], Valid: Total > 0.0 });
+        }
+    }
+
+    AdvanceJump(Run, Drill, State)
+    {
+        const Contacts = State.Vehicle.Wheels.filter((Wheel) => Wheel.Contact).length;
+        if (!Run.Airborne && Contacts === 0)
+        {
+            Run.Airborne = true;
+            Run.TakeOff = Run.Clock;
+        }
+        if (Run.Airborne && Contacts >= 2 && Run.Clock - Run.TakeOff > 0.15)
+        {
+            const Air = Run.Clock - Run.TakeOff;
+            const Distance = State.Position[0] - Drill.Lip;
+            this.Finish({ Primary: Distance, Unit: "m", Lower: false, Lines: [`${Distance.toFixed(1)} m`, `${Air.toFixed(2)} s airtime`], Valid: Air > 0.25 });
+        }
+        else if (Run.Clock > 6.0)
+            this.Finish({ Primary: 0.0, Unit: "m", Lines: ["no jump"], Valid: false });
+    }
+
+    AdvanceSmash(Run, Drill, State)
+    {
+        if (!this.Within(Drill.Zone, State.Position))
+        {
+            const Broken = this.Host.Fracture.Metrics.Breaks - Run.Breaks;
+            this.Finish({ Primary: Broken, Unit: "props", Lower: false, Lines: [`${Broken} props smashed`, `${Run.Clock.toFixed(1)} s in the alley`],
+                          Valid: Broken > 0 });
+        }
+    }
+
+    AdvanceBurnout(Run, Drill, State)
+    {
+        if (State.Vehicle.Burnout)
+            Run.Score += State.Seconds;
+        const Hottest = Math.max(...this.Host.Thermal.Wheels.map((Wheel) => Wheel.Surface)) - 273.15;
+        Run.Hottest = Math.max(Run.Hottest || 0.0, Hottest);
+        if (!this.Within(Drill.Zone, State.Position))
+            this.Finish({ Primary: Run.Score, Unit: "s", Lower: false, Lines: [`${Run.Score.toFixed(1)} s of burnout`, `tyres ${Run.Hottest.toFixed(0)} °C`],
+                          Valid: Run.Score > 0.5 });
+    }
+
+    // 📝 Result: { Primary, Unit, Lower (smaller is better), Lines, Valid }.
+    Finish(Result)
+    {
+        const Run = this.Active;
+        if (!Run || Run.Phase !== "running")
+            return;
+        Run.Phase = "finished";
+        Run.Result = Result;
+        const Id = Run.Drill.Id;
+        (this.Results[Id] = this.Results[Id] || []).unshift({ ...Result, At: Date.now() });
+        this.Results[Id].length = Math.min(this.Results[Id].length, 6);
+        const Best = this.Best[Id];
+        const Better = Result.Valid && (Best === undefined || (Result.Lower ? Result.Primary < Best.Primary : Result.Primary > Best.Primary));
+        if (Better)
+        {
+            this.Best[Id] = { Primary: Result.Primary, Unit: Result.Unit, Lower: !!Result.Lower };
+            this.StoreBest();
+        }
+        Run.NewBest = Better;
+        this.Host.Shell.Announce(`${Run.Drill.Name}: ${FormatPrimary(Result)}${Better ? " — new best!" : ""}`);
+        if (this.OnResult)
+            this.OnResult(Id, Result);
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                     HUD
+    //--------------------------------------------------------------------------------------------------------------------
+
+    ConstructHud()
+    {
+        const Stage = document.getElementById("stage");
+        if (!Stage)
+            return;
+        this.Hud = document.createElement("div");
+        this.Hud.id = "drill-hud";
+        this.Hud.className = "hidden";
+        this.HudParts = ["drill-hud-name", "drill-hud-primary", "drill-hud-lines", "drill-hud-best"].map((ClassName) =>
+        {
+            const Part = document.createElement("div");
+            Part.className = ClassName;
+            this.Hud.appendChild(Part);
+            return Part;
+        });
+        Stage.appendChild(this.Hud);
+    }
+
+    RefreshHud()
+    {
+        if (!this.Hud)
+            return;
+        const Run = this.Active;
+        this.Hud.classList.toggle("hidden", !Run);
+        if (!Run)
+            return;
+        const [Name, Primary, Lines, Best] = this.HudParts;
+        Name.textContent = Run.Drill.Name.toUpperCase();
+        let Text = "", Detail = [];
+        if (Run.Phase === "armed")
+        {
+            Text = "READY";
+            Detail = [Run.Drill.Note];
+        }
+        else if (Run.Phase === "running")
+        {
+            if (Run.Drill.Id === "drift" || Run.Drill.Id === "skidpad")
+            {
+                Text = `${Math.round(Run.Score + Run.Chain)}`;
+                Detail = [Run.Chain > 0.0 ? `chain ${Math.round(Run.Chain)} ×${Run.Multiplier.toFixed(0)}` : "slide it", `angle ${Math.round(Run.Angle || 0)}°`];
+            }
+            else if (Run.Drill.Id === "spin")
+            {
+                Text = `${Run.Score} × 360°`;
+                Detail = [`${(Math.abs(Run.Turned) * 180.0 / Math.PI % 360).toFixed(0)}° into the next`];
+            }
+            else if (Run.Drill.Id === "burnout")
+            {
+                Text = `${Run.Score.toFixed(1)} s`;
+                Detail = [`tyres ${(Run.Hottest || 0).toFixed(0)} °C`];
+            }
+            else
+            {
+                Text = `${Run.Clock.toFixed(2)} s`;
+                Detail = Object.entries(Run.Splits).filter(([Key]) => Key !== "BrakeAt")
+                               .map(([Key, Value]) => `${{ SixtyFoot: "60 ft", Hundred: "0–100", Trap: "trap" }[Key] || Key} ${Key === "Trap" ? `${Value.toFixed(0)} km/h` : `${Value.toFixed(2)} s`}`);
+            }
+        }
+        else if (Run.Result)
+        {
+            Text = FormatPrimary(Run.Result);
+            Detail = Run.Result.Lines;
+        }
+        Primary.textContent = Text;
+        Lines.textContent = Detail.join("  ·  ");
+        const Record = this.Best[Run.Drill.Id];
+        Best.textContent = Record ? `best ${FormatPrimary(Record)}${Run.NewBest && Run.Phase === "finished" ? " — NEW" : ""}` : "";
+        if (this.Hud.dataset)
+            this.Hud.dataset.phase = Run.Phase;
+    }
+
+    QueryReadout()
+    {
+        const Run = this.Active;
+        return [Run ? `${Run.Drill.Name}: ${Run.Phase}${Run.Phase === "running" ? ` · ${Run.Clock.toFixed(1)} s` : ""}` : "no drill running — drive into a station",
+                `results this session: ${Object.values(this.Results).reduce((Sum, List) => Sum + List.length, 0)} · best times stored: ${Object.keys(this.Best).length}`];
+    }
+
+    ClearBest()
+    {
+        this.Best = {};
+        this.StoreBest();
+    }
+}
+
+function Format(Value)
+{
+    return Value === undefined ? "–" : Value.toFixed(2);
+}
+
+export function FormatPrimary(Result)
+{
+    if (Result.Unit === "s")
+        return `${Result.Primary.toFixed(2)} s`;
+    if (Result.Unit === "m")
+        return `${Result.Primary.toFixed(1)} m`;
+    if (Result.Unit === "km/h")
+        return `${Result.Primary.toFixed(1)} km/h`;
+    return `${Math.round(Result.Primary)} ${Result.Unit}`;
+}
