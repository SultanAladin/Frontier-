index 0000000..bf555f5
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/RecoveryDirector.js
@@ -0,0 +1,176 @@
+//============================================================================================================================================
+//                                                           RECOVERYDIRECTOR.JS
+//============================================================================================================================================
+// 🧩 Getting the car back: an overturned, spinning-out or lost car (or R, or a teleport) derezzes, is moved, and rezzes in.
+
+// 📝 One sequence for every way the car needs putting back:
+//
+//      ① Derez — the car dissolves cell by cell; with the VFX editor's Momentum on (the default) it carries on under
+//         the solver, coasting with no driver input, and every cube leaves with the car's velocity at its release —
+//         otherwise it freezes where it is (keeping the velocity its cubes inherit);
+//      ② Hidden — gone from the raster, the distance field and the cards for a beat;
+//      ③ Move — the car is respawned at the destination: upright where it lay for a flip, the last safe spot on the
+//         pad for a car that left it, the drill's start or the spawn for R, the chosen place for a teleport;
+//      ④ Rez — still frozen, it assembles from cubes flying in, on fresh tyres;
+//      ⑤ Control — the solver runs again.
+//
+//    Triggers: upside down (or on its side) and nearly still for 1.5 s; airborne for 2.5 s, or airborne and tumbling
+//    hard for 0.9 s; outside the grounds (35 m past the pad) or below them. The old 3 s overturn respawn in the
+//    vehicle solver is gone — this replaces it.
+
+import { CourseConstants, SpawnPoint } from "./CourseStructure.js";
+import { VehicleGeometry } from "./VehicleSpecification.js";
+import { RotateVector, LengthVector } from "./TransformProjection.js";
+
+export const RecoveryReasons = Object.freeze({ Overturned: "Overturned", SpinOut: "Out of control", OutOfBounds: "Out of bounds",
+                                               Respawn: "Respawn", Teleport: "Teleport" });
+
+export const RecoverySettingsDefaults = Object.freeze({
+    Enabled:        true,    // [-] automatic triggers (R and teleports always derez)
+    OverturnSeconds: 1.5,    // [s]
+    AirborneSeconds: 2.5,    // [s]
+    TumbleSeconds:  0.9,     // [s]
+    TumbleRate:     5.0,     // [rad/s]
+    HiddenSeconds:  0.35     // [s]
+});
+
+export class RecoveryDirector
+{
+    constructor(Host)
+    {
+        this.Host     = Host;
+        this.Settings = { ...RecoverySettingsDefaults };
+        this.Stage    = "control";   // control | derez | hidden | rez
+        this.Timer    = 0.0;
+        this.Clock    = 0.0;
+        this.Overturned = 0.0;
+        this.Airborne = 0.0;
+        this.Tumbling = 0.0;
+        this.Safe     = { Position: SpawnPoint.Position.slice(), Yaw: SpawnPoint.Yaw };
+        this.SafeTimer = 0.0;
+        this.Pending  = null;
+        this.Metrics  = { Recoveries: 0, Last: "" };
+    }
+
+    get Busy()
+    {
+        return this.Stage !== "control";
+    }
+
+    // 📝 Before the vehicle steps: watch for the triggers; run the sequence's clock.
+    Advance(Seconds)
+    {
+        const Vehicle = this.Host.Vehicle;
+        this.Clock += Seconds;
+        if (this.Stage === "control")
+        {
+            this.Watch(Vehicle, Seconds);
+            return;
+        }
+        this.Timer -= Seconds;
+        if (this.Timer > 0.0)
+            return;
+        if (this.Stage === "derez")
+        {
+            this.Stage = "hidden";
+            this.Timer = this.Settings.HiddenSeconds;
+            this.Host.Effects.HideVehicle();
+            this.Host.Effects.StopPoses();
+            Vehicle.Frozen = true;
+            Vehicle.Coasting = false;
+            this.Host.AssignVehicleHidden(true);
+        }
+        else if (this.Stage === "hidden")
+        {
+            const Destination = this.Pending.Destination;
+            Vehicle.Respawn([Destination.Position[0], Destination.Position[1], VehicleGeometry.CoMHeight + 0.02], Destination.Yaw);
+            Vehicle.Frozen = true;
+            if (this.Host.RestoreTyres)
+                this.Host.RestoreTyres();
+            this.Host.AfterVehicleMoved();
+            this.Host.AssignVehicleHidden(false);
+            this.Stage = "rez";
+            this.Timer = this.Host.Effects.RezVehicle(Vehicle);
+        }
+        else if (this.Stage === "rez")
+        {
+            this.Host.Effects.ClearVehicleMask();
+            Vehicle.Frozen = false;
+            Vehicle.Hidden = false;
+            this.Stage = "control";
+            const Done = this.Pending && this.Pending.Done;
+            this.Pending = null;
+            if (Done)
+                Done();
+        }
+    }
+
+    Watch(Vehicle, Seconds)
+    {
+        const Up = RotateVector(Vehicle.Orientation, [0.0, 0.0, 1.0]);
+        const Speed = LengthVector(Vehicle.LinearVelocity);
+        const Spin = LengthVector(Vehicle.AngularVelocity);
+        const Contacts = Vehicle.Wheels.filter((Wheel) => Wheel.Contact).length;
+        const P = Vehicle.Position;
+        // 📝 The last place the car sat squarely on the pad, every half second.
+        this.SafeTimer += Seconds;
+        if (this.SafeTimer > 0.5 && Contacts === 4 && Up[2] > 0.9 && this.WithinPad(P, 0.0))
+        {
+            this.SafeTimer = 0.0;
+            const Forward = RotateVector(Vehicle.Orientation, [1.0, 0.0, 0.0]);
+            this.Safe = { Position: [P[0], P[1]], Yaw: Math.atan2(Forward[1], Forward[0]) };
+        }
+        if (!this.Settings.Enabled)
+            return;
+        this.Overturned = Up[2] < 0.3 && Speed < 2.5 ? this.Overturned + Seconds : 0.0;
+        this.Airborne = Contacts === 0 ? this.Airborne + Seconds : 0.0;
+        this.Tumbling = Contacts === 0 && Spin > this.Settings.TumbleRate ? this.Tumbling + Seconds : 0.0;
+        if (this.Overturned > this.Settings.OverturnSeconds)
+            this.Begin(RecoveryReasons.Overturned, this.ResolveUpright(Vehicle));
+        else if (this.Airborne > this.Settings.AirborneSeconds || this.Tumbling > this.Settings.TumbleSeconds)
+            this.Begin(RecoveryReasons.SpinOut, this.WithinPad(P, 0.0) ? this.ResolveUpright(Vehicle) : this.Safe);
+        else if (!this.WithinPad(P, 35.0) || P[2] < -3.0)
+            this.Begin(RecoveryReasons.OutOfBounds, this.Safe);
+    }
+
+    WithinPad(Position, Margin)
+    {
+        const C = CourseConstants;
+        return Position[0] > C.PadMinimum[0] - Margin && Position[0] < C.PadMaximum[0] + Margin &&
+               Position[1] > C.PadMinimum[1] - Margin && Position[1] < C.PadMaximum[1] + Margin;
+    }
+
+    // 📝 Upright where it lies, keeping its heading.
+    ResolveUpright(Vehicle)
+    {
+        const Forward = RotateVector(Vehicle.Orientation, [1.0, 0.0, 0.0]);
+        const Heading = Math.hypot(Forward[0], Forward[1]) > 0.2 ? Math.atan2(Forward[1], Forward[0]) : this.Safe.Yaw;
+        return { Position: [Vehicle.Position[0], Vehicle.Position[1]], Yaw: Heading };
+    }
+
+    // 📝 Starts the sequence toward Destination { Position [x, y], Yaw [rad] }; Done runs once the car has control.
+    Begin(Reason, Destination, Done = null)
+    {
+        if (this.Busy)
+            return false;
+        const Vehicle = this.Host.Vehicle;
+        this.Pending = { Reason, Destination, Done };
+        this.Stage = "derez";
+        this.Timer = this.Host.Effects.DerezVehicle(Vehicle);
+        const Momentum = !!this.Host.Effects.Settings.Momentum;
+        Vehicle.Frozen = !Momentum;
+        Vehicle.Coasting = Momentum;
+        this.Overturned = this.Airborne = this.Tumbling = 0.0;
+        this.Metrics.Recoveries++;
+        this.Metrics.Last = Reason;
+        if (this.Host.Shell)
+            this.Host.Shell.Announce(Reason === RecoveryReasons.Teleport ? "Derezzing…" : `${Reason} — derezzing`);
+        return true;
+    }
+
+    QueryReadout()
+    {
+        return [`stage: ${this.Stage}${this.Busy ? ` (${Math.max(0.0, this.Timer).toFixed(1)} s)` : ""} · recoveries ${this.Metrics.Recoveries}${this.Metrics.Last ? ` · last: ${this.Metrics.Last}` : ""}`,
+                `safe spot: ${this.Safe.Position[0].toFixed(0)}, ${this.Safe.Position[1].toFixed(0)}`];
+    }
+}
diff --git a/Experimental/IlluminationHost/Source/ResamplingSequence.js b/Experimental/IlluminationHost/Source/ResamplingSequence.js
new file mode 100644
index 0000000..be6f6f1
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/ResamplingSequence.js
@@ -0,0 +1,91 @@
+//============================================================================================================================================
+//                                                          RESAMPLINGSEQUENCE.JS
+//============================================================================================================================================
+// 🧩 The ReSTIR GI final gather over the scene distance field and the surface cards, plus the glossy reflection rays.
+
+// 📝 Order per frame: ① ResampleTemporal (initial candidate + temporal reuse, writes this frame's guide and
+//    reservoirs); ② ResampleSpatial (spatial reuse + resolve into demodulated irradiance); ③ TraverseReflection.
+//    Reservoirs and guides alternate between two slots by frame parity; the resolved signals are single.
+const ReservoirStride = 32;   // [B] - ReservoirRecord
+
+export class ResamplingSequence
+{
+    constructor(Exchange, Shaders)
+    {
+        this.Exchange = Exchange;
+        this.Shaders  = Shaders;
+    }
+
+    async ConstructPrograms(FrameRecords, MaterialRecords, DistanceLayout, SamplingLayout)
+    {
+        this.FrameRecords    = FrameRecords;
+        this.MaterialRecords = MaterialRecords;
+        const Compute = GPUShaderStage.COMPUTE;
+        this.TemporalLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "Texture2D", "TextureDepth2D", "Texture2D", "Texture2D", "StorageTexture2D:rgba16float", "StorageRead", "Storage"],
+            Compute, "Reservoir temporal");
+        this.SpatialLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "Texture2D", "TextureDepth2D", "StorageRead", "StorageTexture2D:rgba16float"], Compute, "Reservoir spatial");
+        this.ReflectionLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "StorageRead", "Texture2D", "TextureDepth2D", "StorageTexture2D:rgba16float"], Compute, "Reflection traversal");
+        this.TemporalProgram   = await this.Shaders.ConstructComputeProgram("ReservoirTemporal.wgsl", "ResampleTemporal",
+                                                                            [this.TemporalLayout, DistanceLayout, SamplingLayout]);
+        this.SpatialProgram    = await this.Shaders.ConstructComputeProgram("ReservoirSpatial.wgsl", "ResampleSpatial",
+                                                                            [this.SpatialLayout, DistanceLayout, SamplingLayout]);
+        this.ReflectionProgram = await this.Shaders.ConstructComputeProgram("ReflectionTraversal.wgsl", "TraverseReflection",
+                                                                            [this.ReflectionLayout, DistanceLayout, SamplingLayout]);
+    }
+
+    ConstructTargets(TraceExtent, Surface)
+    {
+        for (const Resource of this.Resources || [])
+            Resource.destroy();
+        const [Width, Height] = TraceExtent;
+        const Usage = GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING;
+        const Construct = (Label) => this.Exchange.ConstructTexture({ label: Label, size: TraceExtent, format: "rgba16float", usage: Usage });
+        const Guides = [Construct("Resampling guide A"), Construct("Resampling guide B")];
+        const Irradiance = Construct("Resampled irradiance");
+        const Reflection = Construct("Reflection radiance");
+        const Reservoirs = [0, 1].map((Slot) => this.Exchange.ConstructRecords(Width * Height * ReservoirStride,
+                                                                               GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST, `Reservoirs ${Slot}`));
+        this.Resources = [...Guides, Irradiance, Reflection, ...Reservoirs];
+        this.TraceExtent = TraceExtent;
+        this.Views = { Guides: Guides.map((Texture) => Texture.createView()), Irradiance: Irradiance.createView(),
+                       Reflection: Reflection.createView() };
+        this.Reservoirs = Reservoirs;
+        this.TemporalGroups = [0, 1].map((Parity) => this.Exchange.ConstructDescriptorGroup(this.TemporalLayout,
+            [this.FrameRecords, Surface.Views.Attributes, Surface.Views.Depth, Surface.Views.Motion, this.Views.Guides[1 - Parity],
+             this.Views.Guides[Parity], Reservoirs[1 - Parity], Reservoirs[Parity]]));
+        this.SpatialGroups = [0, 1].map((Parity) => this.Exchange.ConstructDescriptorGroup(this.SpatialLayout,
+            [this.FrameRecords, this.Views.Guides[Parity], Surface.Views.Depth, Reservoirs[Parity], this.Views.Irradiance]));
+        this.ReflectionGroup = this.Exchange.ConstructDescriptorGroup(this.ReflectionLayout,
+            [this.FrameRecords, this.MaterialRecords, Surface.Views.Attributes, Surface.Views.Depth, this.Views.Reflection]);
+    }
+
+    RecordResampling(Encoder, Parity, DistanceGroup, SamplingGroup, TimestampWrites)
+    {
+        const [Width, Height] = this.TraceExtent;
+        const Pass = Encoder.beginComputePass({ label: "ReSTIR GI", timestampWrites: TimestampWrites });
+        Pass.setBindGroup(1, DistanceGroup);
+        Pass.setBindGroup(2, SamplingGroup);
+        Pass.setPipeline(this.TemporalProgram);
+        Pass.setBindGroup(0, this.TemporalGroups[Parity]);
+        Pass.dispatchWorkgroups(Math.ceil(Width / 8), Math.ceil(Height / 8));
+        Pass.setPipeline(this.SpatialProgram);
+        Pass.setBindGroup(0, this.SpatialGroups[Parity]);
+        Pass.dispatchWorkgroups(Math.ceil(Width / 8), Math.ceil(Height / 8));
+        Pass.end();
+    }
+
+    RecordReflection(Encoder, DistanceGroup, SamplingGroup, TimestampWrites)
+    {
+        const [Width, Height] = this.TraceExtent;
+        const Pass = Encoder.beginComputePass({ label: "Reflection traversal", timestampWrites: TimestampWrites });
+        Pass.setPipeline(this.ReflectionProgram);
+        Pass.setBindGroup(0, this.ReflectionGroup);
+        Pass.setBindGroup(1, DistanceGroup);
+        Pass.setBindGroup(2, SamplingGroup);
+        Pass.dispatchWorkgroups(Math.ceil(Width / 8), Math.ceil(Height / 8));
+        Pass.end();
+    }
+}
diff --git a/Experimental/IlluminationHost/Source/RigidBodyWorld.js b/Experimental/IlluminationHost/Source/RigidBodyWorld.js
new file mode 100644
index 0000000..9e2d9f4
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/RigidBodyWorld.js
@@ -0,0 +1,976 @@
+//============================================================================================================================================
+//                                                           RIGIDBODYWORLD.JS
+//============================================================================================================================================
+// 🧩 Convex rigid bodies — debris and cones — against the course, the static colliders, each other and the car, at 120 Hz.
+
+// 📝 Every body is a convex hull: its points (for contacts it makes) and its face planes (for contacts made into it),
+//    both about its centre of mass. That one representation answers every query the arena asks:
+//
+//      ① the course: each hull point below the analytic surface is a contact along the course normal;
+//      ② static colliders (walls, barriers, containers, intact props — world boxes): a hull point inside a box is
+//         pushed out through the nearest face, and a box corner inside a hull pushes the hull off it;
+//      ③ body against body: the points of each inside the other's planes — the deepest plane names the normal and
+//         the depth. A uniform grid finds the pairs; two sleeping bodies are never tested;
+//      ④ the car: its hull spheres and its four wheels against each hull's planes, and each hull's points against
+//         the spheres. Impulses go both ways — the car is a body here, with its mass and inertia, so a concrete slab
+//         stops it and a cone does not;
+//      ⑤ the car can also drive OVER a heavy body: QuerySupport answers the vehicle solver's strut casts with the
+//         highest hull top under the wheel, and the wheel's load is handed back to that body as an impulse.
+//
+//    Contacts are resolved with sequential impulses (restitution only for real approaches, Coulomb friction) and a
+//    split positional projection. Bodies sleep once settled and cost nothing until something with real momentum
+//    reaches them; a cone at rest is a sleeping body, so a hundred and thirty of them are free until the car arrives.
+
+import { ResolveCourseHeight, ResolveCourseNormal } from "./CourseStructure.js";
+import { HullSpheres } from "./VehicleSolver.js";
+import { VehicleGeometry, ResolveInertia } from "./VehicleSpecification.js";
+import { AddVector, SubtractVector, ScaleVector, DotVector, CrossVector, LengthVector, NormalizeVector, MultiplyAddVector,
+         RotateVector, ConjugateQuaternion, IntegrateQuaternion } from "./TransformProjection.js";
+
+const Gravity        = 9.81;         // [m/s²]
+const SubstepSeconds = 1.0 / 120.0;  // [s]
+const SubstepCeiling = 4;            // [-]   per frame, so a stalled tab does not spiral
+const Iterations     = 4;            // [-]   impulse passes per substep
+const SleepSpeed     = 0.11;         // [m/s] at the hull (linear, and spin × radius)
+const SleepSeconds   = 0.35;         // [s]
+const BounceSpeed    = 0.7;          // [m/s] below this approach a contact is plastic (no restitution, no jitter)
+const Slop           = 0.002;        // [m]   penetration left alone
+const Projection     = 0.7;          // [-]   share of the remaining penetration removed per substep
+const CellExtent     = 1.25;         // [m]   broadphase grid pitch
+const VehicleReach   = 4.2;          // [m]   car bounding sphere about its centre of mass
+const SupportMass    = 2.0;          // [kg]  bodies at least this heavy carry a wheel (and are pinned by it); lighter ones are shoved aside
+const PebbleRadius   = 0.12;         // [m]   smaller pieces than this pass under a tyre instead of being struck by it
+const WakeSpeed      = 0.35;         // [m/s] an approach this fast wakes a sleeping body
+
+export const RigidSettingsDefaults = Object.freeze({
+    Bounce:   1.0,   // [×] scale on every body's restitution
+    Friction: 1.0,   // [×] scale on every body's friction
+    Vehicle:  true   // [-] the car pushes bodies and feels them
+});
+
+export class RigidBodyWorld
+{
+    constructor()
+    {
+        this.Bodies      = [];
+        this.Obstacles   = [];
+        this.Accumulator = 0.0;
+        this.Settings    = { ...RigidSettingsDefaults };
+        this.NextId      = 1;
+        this.Support     = [];   // heavy bodies near the car, refreshed per frame for QuerySupport
+        this.Metrics     = { Bodies: 0, Awake: 0, Contacts: 0, Pairs: 0, Milliseconds: 0.0 };
+        this.VehicleInertia = ResolveInertia();
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                   BODIES
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 Spec: { Position, Orientation, Linear?, Angular?, Mass, Inertia [3] (principal, body frame), Points, Planes,
+    //    Restitution, Friction, Sleeping?, Owner?, Kind? }. Points and planes are about the centre of mass.
+    AddBody(Spec)
+    {
+        let Radius = 0.0;
+        for (const Point of Spec.Points)
+            Radius = Math.max(Radius, LengthVector(Point));
+        const Samples = Spec.Samples || ConstructContactSamples(Spec.Points, Spec.Planes);
+        const Body = {
+            Id:             this.NextId++,
+            Kind:           Spec.Kind || "debris",
+            Owner:          Spec.Owner || null,
+            Position:       Spec.Position.slice(),
+            Orientation:    Spec.Orientation.slice(),
+            Linear:         Spec.Linear ? Spec.Linear.slice() : [0.0, 0.0, 0.0],
+            Angular:        Spec.Angular ? Spec.Angular.slice() : [0.0, 0.0, 0.0],
+            Mass:           Spec.Mass,
+            InverseMass:    1.0 / Spec.Mass,
+            InverseInertia: Spec.Inertia.map((Moment) => 1.0 / Math.max(Moment, 1.0e-6)),
+            Points:         Spec.Points,
+            Planes:         Spec.Planes,
+            Samples,
+            Radius,
+            Restitution:    Spec.Restitution ?? 0.2,
+            Friction:       Spec.Friction ?? 0.6,
+            Sleeping:       !!Spec.Sleeping,
+            Still:          0.0,
+            Touching:       false,
+            Carries:        Spec.Mass >= SupportMass,
+            WorldPoints:    new Float64Array(Spec.Points.length * 3),
+            WorldSamples:   new Float64Array(Samples.length * 3),
+            WorldPlanes:    new Float64Array(Spec.Planes.length * 4),
+            Rotation:       new Float64Array(9),
+            Woke:           false,   // [-] set when the body wakes this frame (owners read and clear it)
+            Moved:          !Spec.Sleeping
+        };
+        this.RefreshBody(Body);
+        this.Bodies.push(Body);
+        return Body;
+    }
+
+    RemoveBody(Body)
+    {
+        const Index = this.Bodies.indexOf(Body);
+        if (Index >= 0)
+            this.Bodies.splice(Index, 1);
+    }
+
+    // 📝 Puts a body somewhere, at rest and asleep (a cone rezzed back onto its mark).
+    PlaceBody(Body, Position, Orientation, Sleeping = true)
+    {
+        Body.Position = Position.slice();
+        Body.Orientation = Orientation.slice();
+        Body.Linear = [0.0, 0.0, 0.0];
+        Body.Angular = [0.0, 0.0, 0.0];
+        Body.Sleeping = Sleeping;
+        Body.Still = 0.0;
+        Body.Moved = true;
+        this.RefreshBody(Body);
+    }
+
+    Wake(Body)
+    {
+        if (Body.Sleeping)
+        {
+            Body.Sleeping = false;
+            Body.Woke = true;
+        }
+        Body.Still = 0.0;
+    }
+
+    // 📝 World boxes { Minimum, Maximum } the bodies collide with (the vehicle's obstacle list).
+    AssignObstacles(Boxes)
+    {
+        this.Obstacles = Boxes;
+    }
+
+    // 📝 Rotation matrix, world points and world planes of a body at its current pose.
+    RefreshBody(Body)
+    {
+        const [X, Y, Z, W] = Body.Orientation;
+        const R = Body.Rotation;
+        R[0] = 1 - 2 * (Y * Y + Z * Z); R[1] = 2 * (X * Y - Z * W);     R[2] = 2 * (X * Z + Y * W);
+        R[3] = 2 * (X * Y + Z * W);     R[4] = 1 - 2 * (X * X + Z * Z); R[5] = 2 * (Y * Z - X * W);
+        R[6] = 2 * (X * Z - Y * W);     R[7] = 2 * (Y * Z + X * W);     R[8] = 1 - 2 * (X * X + Y * Y);
+        const P = Body.Position;
+        for (let Index = 0; Index < Body.Points.length; ++Index)
+        {
+            const [A, B, C] = Body.Points[Index];
+            Body.WorldPoints[Index * 3 + 0] = P[0] + R[0] * A + R[1] * B + R[2] * C;
+            Body.WorldPoints[Index * 3 + 1] = P[1] + R[3] * A + R[4] * B + R[5] * C;
+            Body.WorldPoints[Index * 3 + 2] = P[2] + R[6] * A + R[7] * B + R[8] * C;
+        }
+        for (let Index = 0; Index < Body.Samples.length; ++Index)
+        {
+            const [A, B, C] = Body.Samples[Index];
+            Body.WorldSamples[Index * 3 + 0] = P[0] + R[0] * A + R[1] * B + R[2] * C;
+            Body.WorldSamples[Index * 3 + 1] = P[1] + R[3] * A + R[4] * B + R[5] * C;
+            Body.WorldSamples[Index * 3 + 2] = P[2] + R[6] * A + R[7] * B + R[8] * C;
+        }
+        for (let Index = 0; Index < Body.Planes.length; ++Index)
+        {
+            const [A, B, C, D] = Body.Planes[Index];
+            const NX = R[0] * A + R[1] * B + R[2] * C, NY = R[3] * A + R[4] * B + R[5] * C, NZ = R[6] * A + R[7] * B + R[8] * C;
+            Body.WorldPlanes[Index * 4 + 0] = NX;
+            Body.WorldPlanes[Index * 4 + 1] = NY;
+            Body.WorldPlanes[Index * 4 + 2] = NZ;
+            Body.WorldPlanes[Index * 4 + 3] = D + NX * P[0] + NY * P[1] + NZ * P[2];
+        }
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                  STEPPING
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 After the vehicle steps: up to four 120 Hz substeps. Vehicle (optional) is the VehicleSolver; it is pushed
+    //    and pulled through its velocities only — its pose was already advanced this frame.
+    Advance(Seconds, Vehicle)
+    {
+        const Started = performance.now();
+        for (const Body of this.Bodies)
+            Body.Moved = false;
+        this.Accumulator = Math.min(this.Accumulator + Math.max(0.0, Seconds), SubstepSeconds * SubstepCeiling);
+        const Steps = Math.floor(this.Accumulator / SubstepSeconds);
+        this.Accumulator -= Steps * SubstepSeconds;
+        this.ApplySupportLoads(Vehicle);
+        const Car = Vehicle && this.Settings.Vehicle && !Vehicle.Hidden ? this.ConstructVehicleProxy(Vehicle) : null;
+        let Awake = 0;
+        for (const Body of this.Bodies)
+            if (!Body.Sleeping)
+                Awake++;
+        // 📝 Nothing awake and no car among the bodies: nothing can change.
+        if (Awake === 0 && !(Car && this.AnyNear(Car.Position, VehicleReach + 1.5)))
+        {
+            this.Metrics = { ...this.Metrics, Bodies: this.Bodies.length, Awake: 0, Contacts: 0, Pairs: 0,
+                             Milliseconds: performance.now() - Started };
+            this.RefreshSupport(Vehicle);
+            return;
+        }
+        let Contacts = 0, Pairs = 0;
+        for (let Step = 0; Step < Steps; ++Step)
+        {
+            const Result = this.Step(SubstepSeconds, Car);
+            Contacts += Result.Contacts;
+            Pairs += Result.Pairs;
+        }
+        if (Car)
+            this.ReturnVehicleProxy(Car, Vehicle);
+        Awake = 0;
+        for (const Body of this.Bodies)
+            if (!Body.Sleeping)
+                Awake++;
+        this.Metrics = { Bodies: this.Bodies.length, Awake, Contacts: Steps > 0 ? Math.round(Contacts / Steps) : 0,
+                         Pairs: Steps > 0 ? Math.round(Pairs / Steps) : 0, Milliseconds: performance.now() - Started };
+        this.RefreshSupport(Vehicle);
+    }
+
+    AnyNear(Position, Reach)
+    {
+        for (const Body of this.Bodies)
+        {
+            const DX = Body.Position[0] - Position[0], DY = Body.Position[1] - Position[1], DZ = Body.Position[2] - Position[2];
+            const Limit = Reach + Body.Radius;
+            if (DX * DX + DY * DY + DZ * DZ < Limit * Limit)
+                return true;
+        }
+        return false;
+    }
+
+    Step(Δτ, Car)
+    {
+        // ① integrate the awake bodies
+        for (const Body of this.Bodies)
+        {
+            if (Body.Sleeping)
+                continue;
+            Body.Linear[2] -= Gravity * Δτ;
+            // 📝 A body under a wheel is pinned by the wheel's load: its motion dies away quickly.
+            const Drag = Body.Pressed ? 0.8 : 1.0 - 0.04 * Δτ, Spin = Body.Pressed ? 0.8 : 1.0 - 0.1 * Δτ;
+            Body.Linear[0] *= Drag; Body.Linear[1] *= Drag; Body.Linear[2] *= Drag;
+            Body.Angular[0] *= Spin; Body.Angular[1] *= Spin; Body.Angular[2] *= Spin;
+            Body.Position[0] += Body.Linear[0] * Δτ;
+            Body.Position[1] += Body.Linear[1] * Δτ;
+            Body.Position[2] += Body.Linear[2] * Δτ;
+            Body.Orientation = IntegrateQuaternion(Body.Orientation, Body.Angular, Δτ);
+            Body.Touching = false;
+            Body.Moved = true;
+            this.RefreshBody(Body);
+        }
+
+        // ② contacts: course, static boxes, pairs, car
+        const Contacts = [];
+        for (const Body of this.Bodies)
+        {
+            if (Body.Sleeping)
+                continue;
+            this.CollectCourseContacts(Body, Contacts);
+            this.CollectObstacleContacts(Body, Contacts);
+        }
+        const Pairs = this.CollectPairContacts(Contacts);
+        if (Car)
+            this.CollectVehicleContacts(Car, Contacts);
+
+        // ③ impulses, then positional projection
+        const Bounce = this.Settings.Bounce, Grip = this.Settings.Friction;
+        for (let Iteration = 0; Iteration < Iterations; ++Iteration)
+            for (const Contact of Contacts)
+                this.ResolveContact(Contact, Iteration === 0, Bounce, Grip, Car);
+        for (const Body of this.Bodies)
+            Body.Shift = null;
+        for (const Contact of Contacts)
+            this.ProjectContact(Contact);
+
+        // ④ sleep
+        for (const Body of this.Bodies)
+        {
+            if (Body.Sleeping)
+                continue;
+            this.RefreshBody(Body);
+            // 📝 Calm is judged by speed at the hull, so a 2 cm shard's spin jitter does not keep it awake for ever.
+            const Speed = LengthVector(Body.Linear), Spin = LengthVector(Body.Angular) * Math.max(Body.Radius, 0.05);
+            const Calm = Speed < SleepSpeed && Spin < SleepSpeed;
+            if (Body.Touching && Speed < 3.0 * SleepSpeed && Spin < 3.0 * SleepSpeed)
+            {
+                // 📝 Resting contact bleeds the last of the motion away — rolling resistance and the friction a pile's
+                //    many contacts really have — so a heap of planks settles instead of jostling for ever.
+                Body.Angular = ScaleVector(Body.Angular, 0.88);
+                Body.Linear = ScaleVector(Body.Linear, 0.92);
+            }
+            Body.Still = Body.Touching && Calm ? Body.Still + Δτ : 0.0;
+            if (Body.Still > SleepSeconds)
+            {
+                Body.Sleeping = true;
+                Body.Linear = [0.0, 0.0, 0.0];
+                Body.Angular = [0.0, 0.0, 0.0];
+            }
+        }
+        return { Contacts: Contacts.length, Pairs };
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                  CONTACTS
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 Contact: { A (body), B (body, Car or null), Point, Normal (pushes A out of B), Depth, Restitution, Friction }.
+    CollectCourseContacts(Body, Contacts)
+    {
+        const Points = Body.WorldPoints;
+        for (let Index = 0; Index < Body.Points.length; ++Index)
+        {
+            const X = Points[Index * 3], Y = Points[Index * 3 + 1], Z = Points[Index * 3 + 2];
+            const Ground = ResolveCourseHeight(X, Y);
+            if (Z >= Ground)
+                continue;
+            const Normal = Ground > 0.0 ? ResolveCourseNormal(X, Y) : [0.0, 0.0, 1.0];
+            Contacts.push({ A: Body, B: null, Point: [X, Y, Z], Normal, Depth: (Ground - Z) * Normal[2],
+                            Restitution: Body.Restitution, Friction: Body.Friction });
+            Body.Touching = true;
+        }
+    }
+
+    CollectObstacleContacts(Body, Contacts)
+    {
+        const P = Body.Position, Reach = Body.Radius;
+        for (const Box of this.Obstacles)
+        {
+            if (P[0] + Reach < Box.Minimum[0] || P[0] - Reach > Box.Maximum[0] || P[1] + Reach < Box.Minimum[1] ||
+                P[1] - Reach > Box.Maximum[1] || P[2] + Reach < Box.Minimum[2] || P[2] - Reach > Box.Maximum[2])
+                continue;
+            // ① hull points inside the box leave through its nearest face
+            const Points = Body.WorldPoints;
+            for (let Index = 0; Index < Body.Points.length; ++Index)
+            {
+                const X = Points[Index * 3], Y = Points[Index * 3 + 1], Z = Points[Index * 3 + 2];
+                if (X <= Box.Minimum[0] || X >= Box.Maximum[0] || Y <= Box.Minimum[1] || Y >= Box.Maximum[1] ||
+                    Z <= Box.Minimum[2] || Z >= Box.Maximum[2])
+                    continue;
+                const Exits = [X - Box.Minimum[0], Box.Maximum[0] - X, Y - Box.Minimum[1], Box.Maximum[1] - Y, Z - Box.Minimum[2], Box.Maximum[2] - Z];
+                let Face = 0;
+                for (let Candidate = 1; Candidate < 6; ++Candidate)
+                    if (Exits[Candidate] < Exits[Face])
+                        Face = Candidate;
+                const Normal = [0.0, 0.0, 0.0];
+                Normal[Face >> 1] = (Face & 1) ? 1.0 : -1.0;
+                Contacts.push({ A: Body, B: null, Point: [X, Y, Z], Normal, Depth: Exits[Face], Restitution: Body.Restitution, Friction: Body.Friction });
+                Body.Touching = true;
+            }
+            // ② box corners inside the hull push the hull off them (a slab landing across a barrier's edge)
+            if (Body.Radius > 0.25)
+            {
+                for (let Corner = 0; Corner < 8; ++Corner)
+                {
+                    const C = [(Corner & 1) ? Box.Maximum[0] : Box.Minimum[0], (Corner & 2) ? Box.Maximum[1] : Box.Minimum[1],
+                               (Corner & 4) ? Box.Maximum[2] : Box.Minimum[2]];
+                    const Inside = this.MeasureInside(Body, C);
+                    if (!Inside)
+                        continue;
