-        if (FinalLevel != 0u) imageStore(OutputImage, Pixel, vec4(ToneMap(Centre.rgb), 1.0));
+        if (FinalLevel != 0u) { float D = DitherOffset(Pixel); imageStore(OutputImage, Pixel, vec4(ToneMap(Centre.rgb) + vec3(D, D, D), 1.0)); }   // V5
