--- a/Engine/Shaders/AtrousDenoise.slang
+++ b/Engine/Shaders/AtrousDenoise.slang
@@ -80,6 +80,17 @@
     return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
