+/*
+==============================================================================================================================================
+                                                            WORKSPACEPANEL.CSS
+==============================================================================================================================================
+ 🧩 The Frontier editor's visual vocabulary for the exhibit: docks, document tabs, outliner rows, property cards, pill sliders and toggles.
+
+ 📝 Tokens and rules follow the Project-Zero editor (Experimental/ProjectZeroEditor/Editor.css, branch arena/215a6f39-frontier):
+    #090909 ground, #121212 docks on #262626 gutters, #252525→#202020 cards with a #343434 edge and 22 px radius,
+    26 px pill sliders filled #454545 on #242424 with a #e0e0e0 thumb, split value fields, #34c759 toggles, the
+    #ffb454 selection bar, DM Sans at 13 px / 300.
+*/
+
+*
+{
+    box-sizing: border-box;
+}
+
+html, body
+{
+    width: 100%;
+    height: 100%;
+    margin: 0;
+    overflow: hidden;
+}
+
+body
+{
+    background: #090909;
+    color: #f0f0f0;
+    font-family: "DM Sans", "Segoe UI", Roboto, system-ui, sans-serif;
+    font-size: 13px;
+    font-weight: 300;
+}
+
+button, input, select, textarea
+{
+    font: inherit;
+    color: inherit;
+}
+
+button
+{
+    cursor: pointer;
+    border: 1px solid #ffffff0d;
+    background: #222;
+    border-radius: 16px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 7px;
+    min-height: 28px;
+    padding: 5px 12px;
+    font-size: 11px;
+}
+
+button:hover { background: #2e2e2e; }
+button:active { background: #383838; }
+button:disabled { opacity: 0.4; cursor: not-allowed; }
+button:focus-visible, input:focus-visible, select:focus-visible { outline: 1px solid #adb2c4; outline-offset: 2px; }
+
+input, select
+{
+    min-width: 0;
+    background: #000;
+    border: 1px solid #ffffff0d;
+    outline: none;
+}
+
+input[type="number"] { appearance: textfield; -moz-appearance: textfield; }
+input::-webkit-inner-spin-button { appearance: none; }
+
+input[type="range"]
+{
+    appearance: none;
+    -webkit-appearance: none;
+    border: 0;
+    height: 26px;
+    border-radius: 30px;
+    background: linear-gradient(90deg, #454545 0 var(--fill, 50%), #242424 var(--fill, 50%) 100%);
+    cursor: ew-resize;
+    min-width: 24px;
+    margin: 0;
+}
+
+input[type="range"]::-webkit-slider-thumb
+{
+    appearance: none;
+    width: 24px;
+    height: 24px;
+    border-radius: 50%;
+    background: #e0e0e0;
+    box-shadow: 0 1px 2px #0008;
+}
+
+input[type="range"]::-moz-range-thumb
+{
+    width: 24px;
+    height: 24px;
+    border: 0;
+    border-radius: 50%;
+    background: #e0e0e0;
+}
+
+select
+{
+    height: 32px;
+    border-radius: 16px;
+    padding: 4px 30px 4px 13px;
+    max-width: 100%;
+    color: #ccc;
+}
+
+option { background: #1a1a1a; }
+
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb { border-radius: 9px; background: #242424; }
+::-webkit-scrollbar-thumb:hover { background: #333; }
+::-webkit-scrollbar-track { background: transparent; }
+
+.hidden { display: none !important; }
+
+/* ── Workspace ───────────────────────────────────────────────────────────────────────────────────────────────── */
+
+.workspace
+{
+    display: grid;
+    grid-template-columns: var(--left, 262px) minmax(320px, 1fr) var(--right, 352px);
+    gap: 2px;
+    width: 100%;
+    height: 100%;
+    background: #262626;
+}
+
+/* 📝 Bare view: the side docks leave the grid entirely, so the viewport is the only column — a three-column template
+      with zero-width sides would auto-place the viewport into the first, zero-width column. */
+.workspace.bare
+{
+    grid-template-columns: 1fr;
+    gap: 0;
+}
+
+.workspace.bare .dock.left, .workspace.bare .dock.right { display: none; }
+
+.dock
