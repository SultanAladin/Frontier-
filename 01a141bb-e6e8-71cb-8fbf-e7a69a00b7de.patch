+// 📝 The constant-slope barrier's cross-section (y, z) [m], convex so the fracture blank is the barrier itself.
+export const BarrierProfile = Object.freeze([[-0.3, 0.0], [0.3, 0.0], [0.3, 0.08], [0.1, 0.81], [-0.1, 0.81], [-0.3, 0.08]]);
