+// 📐 Centre of mass expressed in the authored model frame (0.53 − 0.41715 = 0.11285 m), the body rebase.
+export function ResolveCoMAuthoredZ()
+{
+    return VehicleGeometry.CoMHeight - ResolveAuthoredGroundOffset();
