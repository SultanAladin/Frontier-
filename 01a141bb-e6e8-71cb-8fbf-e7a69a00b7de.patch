+        this.Atmosphere.RecordSkyView(Encoder, this.Settings.SolarIlluminance);
+        if (Included("Union"))
+            this.Distance.RecordUnion(Encoder, this.Scene.DistanceCount, this.FrameIndex, this.Metrics.QueryWrites("Distance union"));
+        if (Included("Plume"))
