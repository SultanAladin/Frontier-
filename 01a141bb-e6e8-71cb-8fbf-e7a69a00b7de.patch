+                                                          SmokeYield: this.Settings.PlumeDensity, HeatYield: this.Settings.PlumeHeat,
+                                                          SootYield: this.Settings.PlumeSoot, FireLight: this.Settings.PlumeFireLight,
+                                                          Embers: this.Settings.PlumeEmbers });
