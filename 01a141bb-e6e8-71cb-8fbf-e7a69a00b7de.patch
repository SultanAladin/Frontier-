+    RespawnVehicle()
+    {
+        this.Vehicle.Respawn();
+        this.Carcass.Reset();
+        this.RestoreWheelSets();
+        this.Driver.Reset();
+        this.Chase.Seeded = false;
+        this.PriorValid = false;
+    }
