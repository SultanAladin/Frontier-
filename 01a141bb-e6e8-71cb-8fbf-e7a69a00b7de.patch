+        this.Embers.RecordAdvection(Encoder, this.Plume.State);
+        if (Included("Shadow"))
+            this.Shadow.RecordCascades(Encoder, this.Scene, this.VertexRecords, this.Metrics.QueryWrites("Shadow"), this.Fragments);
