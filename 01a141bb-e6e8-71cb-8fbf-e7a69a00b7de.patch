+            <div class="outliner-search"><input id="outliner-search" type="search" placeholder="Search scene" aria-label="Search scene"></div>
+            <div class="filter-chips" id="filter-chips">
+                <button data-filter="all" aria-pressed="true">All</button><button data-filter="vehicle">Vehicle</button>
+                <button data-filter="effects">Effects</button><button data-filter="breakables">Breakables</button>
+                <button data-filter="lights">Lights</button><button data-filter="render">Render</button>
+            </div>
+            <div class="outliner-rows" id="outliner-rows"></div>
+            <div class="outliner-footer" id="outliner-footer"></div>
+        </aside>
+        <main class="dock centre">
+            <div class="tab-strip"><div class="document-tab active">Viewport</div><div class="notch"><b>Frontier</b> · IlluminationHost</div></div>
+            <header class="viewport-header">
+                <div class="scene-title"><b>Drift yard</b><small>Slate GI · Project-Drive ControlVehicle</small></div>
+                <span class="badge live">LIVE</span>
+                <div class="segmented" id="camera-mode"><button data-mode="chase">Chase</button><button data-mode="free">Free · F8</button></div>
+                <span class="spacer"></span>
+                <button id="burnout-button" title="Line lock: hold B, or latch it here">Burnout · B</button>
+                <button id="respawn-button" title="Put the car back at the burnout box">Respawn · R</button>
+                <button id="bare-button" title="Hide every panel and debug window">Bare view · H</button>
