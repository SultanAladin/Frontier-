+
+.stats .stat small { position: absolute; bottom: 10px; left: 12px; letter-spacing: 0.5px; color: #a1a1a1; font-size: 10px; }
+.stats .stat strong { font-size: 26px; font-weight: 300; position: absolute; bottom: 7px; right: 14px; }
+.stats .stat i { display: block; width: 22px; height: 22px; border-radius: 50%; background: #34c759; }
+.stats .stat i.amber { background: #ffb454; }
+
