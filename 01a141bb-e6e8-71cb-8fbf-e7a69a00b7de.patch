+
+    // 📝 One frame, guarded: an exception is reported once in the failure panel and the next frame still comes, so a
+    //    fault in one stage shows itself instead of freezing the exhibit.
+    AdvanceFrame(Now)
+    {
+        try
+        {
+            this.ResolveFrame(Now);
+        }
+        catch (Failure)
+        {
+            if (!this.FrameFault)
