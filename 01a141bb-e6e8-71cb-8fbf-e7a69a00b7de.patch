+                const Target = this.Bodies[Other];
+                if (!Target.Asleep && Other < Index)
+                    return;
+                const Offset = SubtractVector(Target.Position, Body.Position);
+                const Distance = LengthVector(Offset);
+                const Reach = Body.ProxyRadius + Target.ProxyRadius;
+                if (Distance >= Reach || Distance < 1.0e-6)
+                    return;
+                const Normal = ScaleVector(Offset, 1.0 / Distance);
+                const Approach = DotVector(SubtractVector(Body.Linear, Target.Linear), Normal);
+                if (Target.Asleep && Target.Dynamic && Approach > 1.0)
+                {
+                    Target.Asleep = false;
+                    Target.SleepTimer = 0.0;
+                }
+                const TargetInverse = (Target.Asleep || !Target.Dynamic) ? 0.0 : Target.InverseMass;
+                const Total = Body.InverseMass + TargetInverse;
+                const Overlap = Reach - Distance;
+                Body.Position = MultiplyAddVector(Body.Position, Normal, -Overlap * Body.InverseMass / Total * 0.8);
+                if (TargetInverse > 0.0)
+                    Target.Position = MultiplyAddVector(Target.Position, Normal, Overlap * TargetInverse / Total * 0.8);
+                if (Approach > 0.0)
+                {
+                    const Impulse = Approach / Total * 1.05;
+                    Body.Linear = MultiplyAddVector(Body.Linear, Normal, -Impulse * Body.InverseMass);
+                    if (TargetInverse > 0.0)
+                        Target.Linear = MultiplyAddVector(Target.Linear, Normal, Impulse * TargetInverse);
+                }
+            });
+        });
+    }
+
+    // 📝 The vehicle as kinematic spheres of infinite mass: a struck body is pushed out of the sphere, takes the
+    //    sphere's point velocity along the normal plus a fraction of its tangential motion, and is spun about the
+    //    struck point. Sleeping bodies in reach are woken first.
+    ResolvePushers(Pushers, Hash)
+    {
+        if (!Pushers)
+            return;
+        for (const Pusher of Pushers)
+        {
+            this.VisitNearby(Hash, Pusher.Centre, Pusher.Radius + 1.0, (Index) =>
+            {
+                const Body = this.Bodies[Index];
+                if (!Body.Dynamic)
+                    return;
+                const Offset = SubtractVector(Body.Position, Pusher.Centre);
+                const Distance = LengthVector(Offset);
+                const Reach = Pusher.Radius + Body.ProxyRadius;
+                if (Distance >= Reach || Distance < 1.0e-6)
+                    return;
+                Body.Asleep = false;
+                Body.SleepTimer = 0.0;
+                const Normal = ScaleVector(Offset, 1.0 / Distance);
+                Body.Position = MultiplyAddVector(Body.Position, Normal, Reach - Distance);
+                const Relative = SubtractVector(Body.Linear, Pusher.Velocity);
+                const Approach = DotVector(Relative, Normal);
+                if (Approach >= 0.0)
+                    return;
+                const Lever = ScaleVector(Normal, -Body.ProxyRadius);
+                const Impulse = ScaleVector(Normal, -(1.0 + 0.3) * Approach / Body.InverseMass);
+                const Tangential = SubtractVector(Relative, ScaleVector(Normal, Approach));
+                const Drag = ScaleVector(Tangential, -0.35 / Body.InverseMass);
+                this.ApplyImpulse(Body, AddVector(Impulse, Drag), Lever);
+                Body.Linear[2] = Math.max(Body.Linear[2], 0.6 * Math.min(4.0, -Approach * 0.25));
+            });
+        }
+    }
+}
+
+// 📝 Integer cell key for the pair hash — no string is built per body per substep.
+function ProjectCellKey(CellX, CellY)
+{
+    return (CellX + 32768) * 65536 + (CellY + 32768);
+}
+
+// 📝 A body is pushed by the vehicle only while that vehicle's spheres overlap it; the spin it is given about the
+//    struck point is what makes a crate tumble rather than slide away like a puck.
+export function ProjectPusherVelocity(Centre, Position, Linear, Angular)
+{
+    return AddVector(Linear, CrossVector(Angular, SubtractVector(Centre, Position)));
+}
+
diff --git a/Experimental/IlluminationHost/Source/DeviceExchange.js b/Experimental/IlluminationHost/Source/DeviceExchange.js
new file mode 100644
index 0000000..86ab206
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/DeviceExchange.js
@@ -0,0 +1,165 @@
+//============================================================================================================================================
+//                                                            DEVICEEXCHANGE.JS
+//============================================================================================================================================
+// 🧩 WebGPU adapter and device negotiation, descriptor layout construction and resource creation across the vendor edge.
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                CAPABILITY NEGOTIATION
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 Optional capabilities are requested only when the adapter offers them; nothing in the renderer depends on one.
+const OptionalFeatures = ["timestamp-query"];
+
+// 📝 Limits raised to the adapter's own maximum. The exhibit is written to the default limits, so these only add headroom.
+const RaisedLimits = ["maxStorageBuffersPerShaderStage", "maxComputeWorkgroupStorageSize", "maxBufferSize",
+                      "maxStorageBufferBindingSize", "maxSampledTexturesPerShaderStage", "maxTextureDimension3D"];
+
+export class DeviceExchange
+{
+    constructor()
+    {
+        this.Adapter          = null;
+        this.Device           = null;
+        this.CanvasFormat     = "bgra8unorm";
+        this.TimestampEnabled = false;
+        this.ReportedErrors   = [];
+        this.ErrorListeners   = [];
+    }
+
+    async ConstructDevice()
+    {
+        if (!("gpu" in navigator))
+            throw new Error("This browser does not expose WebGPU (navigator.gpu is absent). Use a current Chrome, Edge or Safari.");
+        this.Adapter = await navigator.gpu.requestAdapter({ powerPreference: "high-performance" });
+        if (!this.Adapter)
+            throw new Error("No WebGPU adapter is available on this system.");
+
+        const RequiredFeatures = OptionalFeatures.filter((Feature) => this.Adapter.features.has(Feature));
+        const RequiredLimits = {};
+        for (const Limit of RaisedLimits)
+        {
+            if (Limit in this.Adapter.limits)
+                RequiredLimits[Limit] = this.Adapter.limits[Limit];
+        }
+
+        this.Device = await this.Adapter.requestDevice({ requiredFeatures: RequiredFeatures, requiredLimits: RequiredLimits });
+        this.TimestampEnabled = this.Device.features.has("timestamp-query");
+        this.CanvasFormat = navigator.gpu.getPreferredCanvasFormat();
+
+        this.Device.addEventListener("uncapturederror", (Event) =>
+        {
+            const Message = Event.error && Event.error.message ? Event.error.message : String(Event.error);
+            if (this.ReportedErrors.length < 64)
+                this.ReportedErrors.push(Message);
+            console.error("[WebGPU]", Message);
+            for (const Listener of this.ErrorListeners)
+                Listener(Message);
+        });
+        this.Device.lost.then((Loss) =>
+        {
+            console.error("[WebGPU] device lost:", Loss.reason, Loss.message);
+            for (const Listener of this.ErrorListeners)
+                Listener(`Device lost: ${Loss.message}`);
+        });
+        return this.Device;
+    }
+
+    QueryAdapterDescription()
+    {
+        const Information = this.Adapter.info || {};
+        const Parts = [Information.vendor, Information.architecture, Information.device, Information.description];
+        return Parts.filter((Part) => Part && Part.length > 0).join(" · ") || "WebGPU adapter";
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                              DESCRIPTOR LAYOUTS
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 A layout is declared as an ordered list of resource codes; the descriptor slot is the position in the list.
+    //    Explicit layouts keep a slot valid even when one entry point of a module leaves it unreferenced.
+    ConstructDescriptorLayout(ResourceCodes, Visibility = GPUShaderStage.COMPUTE, Label = "")
+    {
+        const Entries = ResourceCodes.map((Code, Index) => ProjectLayoutEntry(Code, Index, Visibility));
+        return this.Device.createBindGroupLayout({ label: Label, entries: Entries });
+    }
+
+    ConstructDescriptorGroup(Layout, Resources, Label = "")
+    {
+        const Entries = Resources.map((Resource, Index) => ({ binding: Index, resource: ProjectGroupResource(Resource) }));
+        return this.Device.createBindGroup({ label: Label, layout: Layout, entries: Entries });
+    }
+
+    ConstructProgramLayout(Layouts, Label = "")
+    {
+        return this.Device.createPipelineLayout({ label: Label, bindGroupLayouts: Layouts });
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                              RESOURCE CREATION
+    //--------------------------------------------------------------------------------------------------------------------
+
+    ConstructRecords(ByteExtent, Usage, Label = "")
+    {
+        const Aligned = Math.max(16, Math.ceil(ByteExtent / 16) * 16);
+        return this.Device.createBuffer({ label: Label, size: Aligned, usage: Usage });
+    }
+
+    ConstructRecordsFrom(TypedContent, Usage, Label = "")
+    {
+        const Aligned = Math.max(16, Math.ceil(TypedContent.byteLength / 16) * 16);
+        const Records = this.Device.createBuffer({ label: Label, size: Aligned, usage: Usage | GPUBufferUsage.COPY_DST,
+                                                   mappedAtCreation: true });
+        new Uint8Array(Records.getMappedRange()).set(new Uint8Array(TypedContent.buffer, TypedContent.byteOffset,
+                                                                    TypedContent.byteLength));
+        Records.unmap();
+        return Records;
+    }
+
+    ConstructTexture(Descriptor)
+    {
+        return this.Device.createTexture(Descriptor);
+    }
+
+    ConstructSampler(Descriptor)
+    {
+        return this.Device.createSampler(Descriptor);
+    }
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                               LAYOUT ENTRY PROJECTION
+//------------------------------------------------------------------------------------------------------------------------
+
+function ProjectLayoutEntry(Code, Index, Visibility)
+{
+    const [Resource, Format] = Code.split(":");
+    const Entry = { binding: Index, visibility: Visibility };
+    switch (Resource)
+    {
+        case "Uniform":               Entry.buffer = { type: "uniform" }; break;
+        case "UniformDynamic":        Entry.buffer = { type: "uniform", hasDynamicOffset: true }; break;
+        case "StorageRead":           Entry.buffer = { type: "read-only-storage" }; break;
+        case "Storage":               Entry.buffer = { type: "storage" }; break;
+        case "Texture2D":             Entry.texture = { sampleType: "float", viewDimension: "2d" }; break;
+        case "Texture2DUnfiltered":   Entry.texture = { sampleType: "unfilterable-float", viewDimension: "2d" }; break;
+        case "Texture2DLayered":        Entry.texture = { sampleType: "float", viewDimension: "2d-array" }; break;
+        case "Texture3D":             Entry.texture = { sampleType: "float", viewDimension: "3d" }; break;
+        case "TextureUint2D":         Entry.texture = { sampleType: "uint", viewDimension: "2d" }; break;
+        case "TextureDepth2D":        Entry.texture = { sampleType: "depth", viewDimension: "2d" }; break;
+        case "TextureDepth2DLayered":   Entry.texture = { sampleType: "depth", viewDimension: "2d-array" }; break;
+        case "StorageTexture2D":      Entry.storageTexture = { access: "write-only", format: Format, viewDimension: "2d" }; break;
+        case "StorageTexture3D":      Entry.storageTexture = { access: "write-only", format: Format, viewDimension: "3d" }; break;
+        case "Sampler":               Entry.sampler = { type: "filtering" }; break;
+        case "SamplerUnfiltered":     Entry.sampler = { type: "non-filtering" }; break;
+        case "SamplerComparison":     Entry.sampler = { type: "comparison" }; break;
+        default: throw new Error(`Unknown descriptor resource code '${Code}'`);
+    }
+    return Entry;
+}
+
+function ProjectGroupResource(Resource)
+{
+    if (typeof GPUBuffer !== "undefined" && Resource instanceof GPUBuffer)
+        return { buffer: Resource };
+    return Resource;
+}
diff --git a/Experimental/IlluminationHost/Source/DisplayProjection.js b/Experimental/IlluminationHost/Source/DisplayProjection.js
new file mode 100644
index 0000000..6e179c9
--- /dev/null
+++ b/Experimental/IlluminationHost/Source/DisplayProjection.js
@@ -0,0 +1,106 @@
+//============================================================================================================================================
+//                                                           DISPLAYPROJECTION.JS
+//============================================================================================================================================
+// 🧩 Recombination, temporal antialiasing, eye adaptation, the distance-field inspection march and the swapchain present.
+
+export class DisplayProjection
+{
+    constructor(Exchange, Shaders)
+    {
+        this.Exchange = Exchange;
+        this.Shaders  = Shaders;
+    }
+
+    async ConstructPrograms(FrameRecords, MaterialRecords, DistanceLayout, SamplingLayout)
+    {
+        this.FrameRecords    = FrameRecords;
+        this.MaterialRecords = MaterialRecords;
+        const Compute = GPUShaderStage.COMPUTE;
+        this.RecombineLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "StorageRead", "Texture2D", "TextureDepth2D", "Texture2D", "Texture2D", "Texture2D", "Texture2D", "Texture2D",
+             "Texture2D", "StorageTexture2D:rgba16float", "Texture2D", "Texture2D"], Compute, "Display recombination");
+        this.AntialiasLayout = this.Exchange.ConstructDescriptorLayout(
+            ["Uniform", "Texture2D", "Texture2D", "Texture2D", "Sampler", "StorageTexture2D:rgba16float"], Compute, "Display antialias");
+        this.ExposureLayout = this.Exchange.ConstructDescriptorLayout(["Uniform", "Texture2D", "Storage"], Compute, "Display exposure");
+        this.InspectionLayout = this.Exchange.ConstructDescriptorLayout(["Uniform", "StorageTexture2D:rgba16float"], Compute, "Inspection march");
+        this.PresentLayout = this.Exchange.ConstructDescriptorLayout(["Uniform", "Texture2D", "StorageRead"],
+                                                                     GPUShaderStage.VERTEX | GPUShaderStage.FRAGMENT, "Display present");
+        this.RecombineProgram  = await this.Shaders.ConstructComputeProgram("DisplayRecombination.wgsl", "ResolveRecombination", [this.RecombineLayout]);
+        this.AntialiasProgram  = await this.Shaders.ConstructComputeProgram("DisplayAntialias.wgsl", "IntegrateAntialias", [this.AntialiasLayout]);
+        this.ExposureProgram   = await this.Shaders.ConstructComputeProgram("DisplayExposure.wgsl", "IntegrateExposure", [this.ExposureLayout]);
+        this.InspectionProgram = await this.Shaders.ConstructComputeProgram("InspectionMarch.wgsl", "MarchInspection",
+                                                                            [this.InspectionLayout, DistanceLayout, SamplingLayout]);
+        this.PresentProgram = await this.Shaders.ConstructRasterProgram("DisplayPresent.wgsl", {
+            VertexEntry: "PresentVertex", FragmentEntry: "PresentFragment",
+            Primitive: { topology: "triangle-list" },
+            Targets: [{ format: `${this.Exchange.CanvasFormat}-srgb` }]
+        }, [this.PresentLayout, DistanceLayout]);
+        this.LinearClamp = this.Exchange.ConstructSampler({ magFilter: "linear", minFilter: "linear" });
+        this.AdaptationRecords = this.Exchange.ConstructRecords(16, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST | GPUBufferUsage.COPY_SRC,
+                                                                "Eye adaptation");
+    }
+
+    ConstructTargets(ScreenExtent, Surface, Resampling, Diffuse, Glossy, Cards, Plume, Embers)
+    {
+        for (const Texture of this.Textures || [])
+            Texture.destroy();
+        const Usage = GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING;
+        const Construct = (Label) => this.Exchange.ConstructTexture({ label: Label, size: ScreenExtent, format: "rgba16float", usage: Usage });
+        const Recombined = Construct("Recombined radiance");
+        const Inspection = Construct("Inspection radiance");
+        const Resolved   = [Construct("Resolved radiance A"), Construct("Resolved radiance B")];
+        this.Textures = [Recombined, Inspection, ...Resolved];
+        this.ScreenExtent = ScreenExtent;
+        this.Views = { Recombined: Recombined.createView(), Inspection: Inspection.createView(), Resolved: Resolved.map((Texture) => Texture.createView()) };
+        this.RecombineGroup = this.Exchange.ConstructDescriptorGroup(this.RecombineLayout,
+            [this.FrameRecords, this.MaterialRecords, Surface.Views.Attributes, Surface.Views.Depth, Surface.Views.Direct, Diffuse.Views.Screen,
+             Glossy.Views.Screen, Resampling.Views.Irradiance, this.Views.Inspection, Cards.Views.Final, this.Views.Recombined, Plume.MarchView, Embers.RadianceView]);
+        this.AntialiasGroups = [0, 1].map((Parity) => this.Exchange.ConstructDescriptorGroup(this.AntialiasLayout,
+            [this.FrameRecords, this.Views.Recombined, this.Views.Resolved[1 - Parity], Surface.Views.Motion, this.LinearClamp, this.Views.Resolved[Parity]]));
+        this.ExposureGroups = [0, 1].map((Parity) => this.Exchange.ConstructDescriptorGroup(this.ExposureLayout,
+            [this.FrameRecords, this.Views.Resolved[Parity], this.AdaptationRecords]));
+        this.PresentGroups = [0, 1].map((Parity) => this.Exchange.ConstructDescriptorGroup(this.PresentLayout,
+            [this.FrameRecords, this.Views.Resolved[Parity], this.AdaptationRecords]));
+        this.InspectionGroup = this.Exchange.ConstructDescriptorGroup(this.InspectionLayout, [this.FrameRecords, this.Views.Inspection]);
+    }
+
+    RecordInspection(Encoder, DistanceGroup, SamplingGroup)
+    {
+        const Pass = Encoder.beginComputePass({ label: "Inspection march" });
+        Pass.setPipeline(this.InspectionProgram);
+        Pass.setBindGroup(0, this.InspectionGroup);
+        Pass.setBindGroup(1, DistanceGroup);
+        Pass.setBindGroup(2, SamplingGroup);
+        Pass.dispatchWorkgroups(Math.ceil(this.ScreenExtent[0] / 8), Math.ceil(this.ScreenExtent[1] / 8));
+        Pass.end();
+    }
+
+    RecordResolve(Encoder, Parity, TimestampWrites)
+    {
+        const [Width, Height] = this.ScreenExtent;
+        const Pass = Encoder.beginComputePass({ label: "Display resolve", timestampWrites: TimestampWrites });
+        Pass.setPipeline(this.RecombineProgram);
+        Pass.setBindGroup(0, this.RecombineGroup);
+        Pass.dispatchWorkgroups(Math.ceil(Width / 8), Math.ceil(Height / 8));
+        Pass.setPipeline(this.AntialiasProgram);
+        Pass.setBindGroup(0, this.AntialiasGroups[Parity]);
+        Pass.dispatchWorkgroups(Math.ceil(Width / 8), Math.ceil(Height / 8));
+        Pass.setPipeline(this.ExposureProgram);
+        Pass.setBindGroup(0, this.ExposureGroups[Parity]);
+        Pass.dispatchWorkgroups(1);
+        Pass.end();
+    }
+
+    RecordPresent(Encoder, Parity, TargetView, DistanceGroup)
+    {
+        const Pass = Encoder.beginRenderPass({
+            label: "Display present",
+            colorAttachments: [{ view: TargetView, clearValue: [0, 0, 0, 1], loadOp: "clear", storeOp: "store" }]
+        });
+        Pass.setPipeline(this.PresentProgram);
+        Pass.setBindGroup(0, this.PresentGroups[Parity]);
+        Pass.setBindGroup(1, DistanceGroup);
+        Pass.draw(3);
+        Pass.end();
+    }
+}
