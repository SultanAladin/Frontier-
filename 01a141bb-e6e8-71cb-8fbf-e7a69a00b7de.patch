+            Body.Angular = [(Random() - 0.5) * 6.0, (Random() - 0.5) * 6.0, (Random() - 0.5) * 6.0];
+            Body.Asleep  = false;
+        }
+    }
+
+    // 📝 Static props laid on the course in a jittered lattice around Centre, kept off the car and the obstacles.
+    SpawnPlaced(Count, Centre)
