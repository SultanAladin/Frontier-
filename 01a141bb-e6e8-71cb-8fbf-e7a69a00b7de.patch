+    const Rear        = new SuspensionSpecification();
+    const FrontCorner = 0.5 * Sprung * VehicleGeometry.FrontWeightFraction;
+    const RearCorner  = 0.5 * Sprung * (1.0 - VehicleGeometry.FrontWeightFraction);
